       {"to": "assess", "label": "told", "when": {"fact": "landlord_notified", "is": true}},
       {"to": "advise_notice", "label": "not told", "when": {"fact": "landlord_notified", "is": false}}
     ]},
    {"id": "assess", "title": "Assess the defect with its evidence", "source_refs": ["fixture#s3"],
     "documents": ["photo", "notice_letter"], "outcome": "reported"},
    {"id": "advise_notice", "title": "Advise telling the landlord first", "source_refs": ["fixture#s4"], "outcome": "advice"}
  ],
  "documents": [
    {"id": "customer_message", "title": "The customer's message", "why": "It states the request.", "source_refs": ["fixture#d1"]},
    {"id": "photo", "title": "Photo of the defect", "why": "It shows the defect.", "source_refs": ["fixture#d2"]},
    {"id": "notice_letter", "title": "Notice to the landlord", "why": "It proves the landlord was told.",
     "required_when": {"fact": "landlord_notified", "is": true}, "source_refs": ["fixture#d3"]}
  ],
  "outcomes": [
    {"id": "reported", "title": "Case reported", "source_refs": ["fixture#o1"]},
    {"id": "advice", "title": "Advice given", "source_refs": ["fixture#o2"]}
