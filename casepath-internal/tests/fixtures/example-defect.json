     "question": "Which legal area does the request concern?", "source_refs": ["fixture#area"]},
    {"id": "landlord_notified", "type": "boolean",
     "question": "Has the tenant told the landlord about the defect?", "source_refs": ["fixture#notice"]}
  ],
  "start": "intake",
  "steps": [
    {"id": "intake", "title": "Read the request", "role": "system", "source_refs": ["fixture#s1"],
