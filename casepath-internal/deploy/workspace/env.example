# Copy to ~/.casepath/env on the development workspace and fill it in there.
# Never commit the filled-in copy: it names internal resources.

# Who the development workspace serves (one person).
CASEPATH_DEV_USER=

# Where cases, original files and the workflow catalogue live on the workspace.
CASEPATH_DATA_DIR=$HOME/.casepath/data
CASEPATH_WORKFLOW_CATALOGUE=$HOME/.casepath/catalogue

# The model: the resource endpoint only (https://<resource>.openai.azure.com)
# and the exact deployment name.
CASEPATH_AZURE_OPENAI_ENDPOINT=
CASEPATH_AZURE_OPENAI_DEPLOYMENT=
# true for reasoning deployments (GPT-5 family), false for GPT-4.1.
CASEPATH_MODEL_REASONING=true
# Sign-in, as the DSL Handbook prescribes for an AML DSW: the person's az sign-in
# (run `az login --use-device-code` on the compute instance first), never the
# compute's attached managed identity. A deployed service would use managed_identity.
CASEPATH_AZURE_CREDENTIAL=cli

# Scanned pages and dossier windows read in parallel per file.
CASEPATH_READING_WORKERS=6

# The local port the workspace's browser proxy opens.
CASEPATH_PORT=8765

# Outbound HTTPS from the workspace passes a firewall with its own CA.
REQUESTS_CA_BUNDLE=
SSL_CERT_FILE=
PIP_CERT=
CASEPATH_CA_BUNDLE=

# Internal package mirror, when direct package downloads are not allowed.
PIP_INDEX_URL=
