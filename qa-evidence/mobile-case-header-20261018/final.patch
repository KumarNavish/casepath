+for (const width of [390, 320, 430, 1428]) test(`mobile case header: retained heating context fits Knowledge and Cases at ${width}px`, async t => {
+  const mobile = width < 600, id = 'clm_314f2d309fea25e6';
+  const page = await fixturePage(t, {width, height: 844, mobile, publicReadOnly: true});
+  // The full product's page stylesheet removes the browser's default margin.
+  await page.evaluate(() => { document.body.style.margin = '0'; });
+  await open(page, id); await title(page, id);
+  const expectedLabel = await page.locator('[data-au-claim-title]').innerText(), measurements = [];
+  for (const view of ['knowledge', 'work']) {
+    const navigation = page.locator(`.au-nav [data-au-nav="${view}"]`);
+    if (mobile) await navigation.tap(); else await navigation.click();
+    await page.locator('[data-au-case-return]').waitFor({state: 'visible'});
+    await page.evaluate(() => document.fonts.ready);
+    const geometry = await page.evaluate(() => {
+      const header = document.querySelector('.au-identity-header'), current = header.querySelector('.au-case-return');
+      const measure = element => {
+        const style = getComputedStyle(element);
+        return {text: element.textContent, rect: element.getBoundingClientRect().toJSON(), clientWidth: element.clientWidth, scrollWidth: element.scrollWidth, overflowX: style.overflowX, whiteSpace: style.whiteSpace};
+      };
+      return {visualWidth: visualViewport.width, scale: visualViewport.scale, innerWidth, documentWidth: document.documentElement.scrollWidth, coarse: matchMedia('(pointer:coarse)').matches,
+        header: measure(header), current: measure(current), label: measure(current.querySelector('.au-case-return-label')), controls: [...current.querySelectorAll('button')].map(measure), navigation: [...header.querySelectorAll('.au-nav button')].map(measure)};
+    });
+    measurements.push({view, ...geometry});
+  }
+  // Capture after both views: Chromium screenshots can change pointer emulation.
+  await focusedReceipt(page, `mobile-case-header-${width}`, {claim_id: id, expectedLabel, mobile, measurements});
+  for (const geometry of measurements) {
+    const detail = JSON.stringify(geometry);
+    assert.equal(geometry.visualWidth, width, `the actual visual viewport keeps its configured width: ${detail}`);
+    assert.equal(geometry.scale, 1, `the header fits without automatic mobile scaling: ${detail}`);
+    assert.equal(geometry.coarse, mobile);
+    assert.ok(geometry.documentWidth <= width + 1, `document width must fit the configured viewport even if innerWidth inflates: ${detail}`);
+    for (const item of [geometry.header, geometry.current, geometry.label, ...geometry.controls, ...geometry.navigation]) {
+      assert.ok(item.rect.left >= -1 && item.rect.right <= geometry.visualWidth + 1, `every retained header item fits the visual viewport: ${detail}`);
+      assert.ok(item.scrollWidth <= item.clientWidth + 1, `header content wraps without clipping or hidden overflow: ${detail}`);
+      assert.notEqual(item.overflowX, 'hidden'); assert.notEqual(item.overflowX, 'clip');
+    }
+    assert.equal(geometry.label.text, expectedLabel, 'the entire selected claim label stays visible');
+    assert.deepEqual(geometry.controls.map(row => row.text), ['Steps', 'Documents']);
+    assert.deepEqual(geometry.navigation.map(row => row.text), ['Cases', 'Demonstration', 'Knowledge']);
+    if (mobile) assert.ok(geometry.controls.every(row => row.rect.width >= 44 && row.rect.height >= 44), `return controls retain 44px coarse-pointer touch targets in both dimensions: ${detail}`);
+    else assert.ok(geometry.controls.every(row => row.rect.top < geometry.label.rect.bottom), `the desktop return context stays on one row: ${detail}`);
+  }
+  const documents = page.locator('[data-au-return-case="documents"]');
+  if (mobile) await documents.tap(); else await documents.click();
+  await title(page, id);
+  assert.equal(await page.locator('[data-au-panel="documents"]').isVisible(), true, 'the fitted return link retains the selected heating claim and Documents view');
+});
