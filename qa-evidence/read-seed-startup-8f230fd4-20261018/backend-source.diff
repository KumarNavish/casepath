+    import os
+    fifo = tmp_path / 'fifo.json'
+    os.mkfifo(fifo)
+    with pytest.raises(SeedError):
+        load_seed(fifo, deployment_commit=COMMIT, expected_sha256=sha256(raw).hexdigest())
