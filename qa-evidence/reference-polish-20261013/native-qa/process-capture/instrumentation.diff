+async function captureUninterruptedProcessSequence(page,fixture,id,directory){
+ const start=fixture.snapshots[id].replay_start,head=fixture.snapshots[id].state.revision,seen=new Set();
+ for(let tick=0;tick<6000&&!seen.has('final');tick++){
+  const paint=await page.evaluate(()=>window.__referencePaints.at(-1));assert.equal(paint.claim_id,id,'capture must finish before the next actual case');
+  const seq=Number(paint.revision),docs=paint.documents.length;
+  if(seq===start.from_seq&&!seen.has('prepared')){await captureUninterruptedProcessFrame(page,fixture,id,directory,'02');seen.add('prepared');}
+  if(paint.nodes.length>1&&docs===0&&!seen.has('graph')){await captureUninterruptedProcessFrame(page,fixture,id,directory,'03');seen.add('graph');}
+  for(const count of [1,2,3])if(docs===count&&!seen.has('documents'+count)){await captureUninterruptedProcessFrame(page,fixture,id,directory,String(count+3).padStart(2,'0'));seen.add('documents'+count);}
+  if(seq===head){assert.ok(paint.outcome);assert.ok(paint.knowledge.length);await captureUninterruptedProcessFrame(page,fixture,id,directory,'07');seen.add('final');break;}
+  await page.clock.runFor(20);
+ }
+ assert.deepEqual([...seen].sort(),['prepared','graph','documents1','documents2','documents3','final'].sort());
