 "example": false,
 "facts": [
  {
   "id": "dispute_family",
   "question": "Which tenancy dispute does the claim concern: a defect (mould, moisture, heating), a lease termination, or a rent increase?",
   "source_refs": [
    "policy-defect_mold_heating-v1#domain"
   ],
   "type": "enum",
   "values": [
    "defect_mold_heating",
    "lease_termination_dispute",
    "rent_increase_dispute"
   ]
  },
  {
   "id": "health_effects",
   "question": "Does the claim allege effects of the defect on anyone's health?",
   "source_refs": [
    "policy-defect_mold_heating-v1#flag:health_effects"
   ],
   "type": "boolean"
  },
  {
   "id": "mold",
   "question": "Does the defect involve mould or moisture?",
   "source_refs": [
    "policy-defect_mold_heating-v1#flag:mold"
   ],
   "type": "boolean"
  },
  {
   "id": "heating",
   "question": "Does the defect involve the heating?",
   "source_refs": [
    "policy-defect_mold_heating-v1#flag:heating"
   ],
   "type": "boolean"
  },
  {
   "id": "specialist_needed",
   "question": "Is a technical inspection by a specialist needed?",
   "source_refs": [
    "policy-defect_mold_heating-v1#flag:specialist_needed"
   ],
   "type": "boolean"
  },
  {
   "id": "deposit_considered",
   "question": "Is depositing the rent with the authority being considered?",
   "source_refs": [
    "policy-defect_mold_heating-v1#flag:deposit_considered"
   ],
   "type": "boolean"
  }
 ],
 "format": "casepath.workflow/1",
 "id": "defect_mold_heating",
 "notes": [
  {
   "source_refs": [
    "policy-defect_mold_heating-v1#policy-defect_mold_heating-v1.clause-01"
   ],
   "text": "Preserve urgent safety needs first."
  },
  {
   "source_refs": [
    "policy-defect_mold_heating-v1#policy-defect_mold_heating-v1.clause-02"
   ],
   "text": "Then establish scope and dates, notice to the landlord, the still-open technical cause, objective condition evidence, and the response or access history."
  },
  {
   "source_refs": [
    "policy-defect_mold_heating-v1#policy-defect_mold_heating-v1.clause-03"
   ],
   "text": "Request only missing material that can resolve an active decision."
  },
  {
   "source_refs": [
    "policy-defect_mold_heating-v1#policy-defect_mold_heating-v1.clause-04"
   ],
   "text": "Treat medical, inspection, heating, moisture-log, and deposit evidence as conditional; do not assume a cause or remedy before its branch is supported."
  }
 ],
 "open_questions": [],
 "outcomes": [
  {
   "id": "closed",
   "source_refs": [
    "policy-defect_mold_heating-v1#close"
   ],
   "title": "Process closed"
  }
