 "sources": [
  {
   "id": "policy-defect_mold_heating-v1",
   "kind": "process_guidance",
   "title": "Generic defect, moisture, mould, and heating workflow (paper rule template policy-defect_mold_heating-v1, sha256 1a3e7ee17fe67971)"
  }
 ],
 "start": "dh_intake",
 "status": "reviewed",
 "steps": [
  {
   "id": "dh_intake",
   "next": [
    {
     "label": "health effects alleged",
     "to": "dh_safety",
     "when": {
      "fact": "health_effects",
      "is": true
     }
    },
    {
     "label": "no immediate health escalation",
     "to": "dh_scope",
     "when": {
      "fact": "health_effects",
      "is": false
     }
    }
   ],
   "role": "claim_handler",
   "source_refs": [
    "policy-defect_mold_heating-v1#dh_intake"
   ],
   "title": "Capture defect and affected rooms"
  },
  {
   "documents": [
    "medical_confirmation"
   ],
   "id": "dh_safety",
   "next": [
    {
     "label": "safety advice recorded",
     "to": "dh_scope",
     "when": true
    }
   ],
   "role": "external_specialist",
   "source_refs": [
    "policy-defect_mold_heating-v1#dh_safety"
   ],
   "title": "Escalate immediate health or safety risk"
  },
  {
   "documents": [
    "lease_contract"
   ],
   "id": "dh_scope",
   "next": [
    {
     "label": "timeline drafted",
     "to": "dh_notice",
     "when": true
    }
   ],
   "role": "claim_handler",
   "source_refs": [
    "policy-defect_mold_heating-v1#dh_scope"
   ],
   "title": "Build the dated defect timeline"
  },
  {
   "documents": [
    "defect_notification",
    "proof_of_notification"
   ],
   "id": "dh_notice",
   "next": [
    {
     "label": "notice position recorded",
     "to": "dh_cause",
     "when": true
    }
   ],
   "role": "claim_handler",
   "source_refs": [
    "policy-defect_mold_heating-v1#dh_notice"
   ],
   "title": "Establish landlord notice"
  },
  {
   "documents": [
    "caretaker_correspondence"
   ],
   "id": "dh_cause",
   "next": [
    {
     "label": "causation status recorded",
     "to": "dh_evidence",
     "when": true
    }
   ],
   "role": "claim_handler",
   "source_refs": [
    "policy-defect_mold_heating-v1#dh_cause"
   ],
   "title": "Keep causation open until supported"
  },
  {
   "documents": [
    "dated_photos",
    "humidity_temperature_log",
    "heating_service_report"
   ],
   "id": "dh_evidence",
   "next": [
    {
     "label": "evidence gaps identified",
     "to": "dh_response",
     "when": true
    }
   ],
   "role": "claim_handler",
   "source_refs": [
    "policy-defect_mold_heating-v1#dh_evidence"
   ],
   "title": "Collect objective defect evidence"
  },
  {
   "documents": [
    "landlord_response_history"
   ],
   "id": "dh_response",
   "next": [
    {
     "label": "technical inspection needed",
     "to": "dh_specialist",
     "when": {
      "fact": "specialist_needed",
      "is": true
     }
    },
    {
     "label": "deposit route considered without specialist",
     "to": "dh_deposit",
     "when": {
      "all": [
       {
        "fact": "deposit_considered",
        "is": true
       },
       {
        "fact": "specialist_needed",
        "is": false
       }
      ]
     }
    },
    {
     "label": "no further specialist or deposit branch",
     "to": "dh_resolution",
     "when": {
      "all": [
       {
        "fact": "specialist_needed",
        "is": false
       },
       {
        "fact": "deposit_considered",
        "is": false
       }
      ]
     }
    }
   ],
   "role": "claim_handler",
   "source_refs": [
    "policy-defect_mold_heating-v1#dh_response"
   ],
   "title": "Review landlord response and access"
  },
  {
   "documents": [
    "technical_inspection"
   ],
   "id": "dh_specialist",
   "next": [
    {
     "label": "deposit route remains relevant",
     "to": "dh_deposit",
     "when": {
      "fact": "deposit_considered",
      "is": true
     }
    },
    {
     "label": "inspection result available",
     "to": "dh_resolution",
     "when": true
    }
   ],
   "role": "external_specialist",
   "source_refs": [
    "policy-defect_mold_heating-v1#dh_specialist"
   ],
   "title": "Obtain technical inspection"
  },
  {
   "documents": [
    "written_repair_deadline"
   ],
   "id": "dh_deposit",
   "next": [
    {
     "label": "deposit safeguards assessed",
     "to": "dh_resolution",
     "when": true
    }
   ],
   "role": "claim_handler",
   "source_refs": [
    "policy-defect_mold_heating-v1#dh_deposit"
   ],
   "title": "Check safeguards for official rent deposit"
  },
  {
   "id": "dh_resolution",
   "next": [
    {
     "label": "outcome recorded",
     "to": "dh_close",
     "when": true
    }
   ],
   "role": "claim_handler",
   "source_refs": [
    "policy-defect_mold_heating-v1#dh_resolution"
   ],
   "title": "Record repair or referral outcome"
  },
  {
   "id": "dh_close",
   "outcome": "closed",
   "role": "claim_handler",
   "source_refs": [
    "policy-defect_mold_heating-v1#dh_close"
   ],
   "title": "Close or hand off the file"
  }
 ],
 "title": "Generic defect, moisture, mould, and heating workflow",
 "version": "2026-11-10"
}
