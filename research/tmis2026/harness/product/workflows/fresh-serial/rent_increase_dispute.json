 "notes": [
  {
   "source_refs": [
    "policy-rent_increase_dispute-v1#policy-rent_increase_dispute-v1.clause-01"
   ],
   "text": "Preserve the challenge deadline first."
  },
  {
   "source_refs": [
    "policy-rent_increase_dispute-v1#policy-rent_increase_dispute-v1.clause-02"
   ],
   "text": "Then verify receipt, official form, timing, current rent, stated reason, and calculation basis."
  },
  {
   "source_refs": [
    "policy-rent_increase_dispute-v1#policy-rent_increase_dispute-v1.clause-03"
   ],
   "text": "Reconstruct reference-rate calculations or renovation costs only when that branch is active."
  },
  {
   "source_refs": [
    "policy-rent_increase_dispute-v1#policy-rent_increase_dispute-v1.clause-04"
   ],
   "text": "Separate supported figures from unresolved inputs and request only missing evidence that can change validity, calculation, or resolution."
  },
  {
   "source_refs": [
    "policy-rent_increase_dispute-v1#policy-rent_increase_dispute-v1.clause-silence"
   ],
   "text": "Silence policy: a branch fact that the claim never mentions is presumed absent; the dispute's defining event (for a termination dispute, that a termination notice was received; for a rent dispute, that a rent-increase notification was received) is presumed to have occurred; a fact that the claim raises but leaves open is unresolved, and the documents that depend on it are held behind a question."
  }
 ],
