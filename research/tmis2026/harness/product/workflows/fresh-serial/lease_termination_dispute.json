 "format": "casepath.workflow/1",
 "id": "lease_termination_dispute",
 "notes": [
  {
   "source_refs": [
    "policy-lease_termination_dispute-v1#policy-lease_termination_dispute-v1.clause-01"
   ],
   "text": "Preserve the challenge deadline first."
  },
  {
   "source_refs": [
    "policy-lease_termination_dispute-v1#policy-lease_termination_dispute-v1.clause-02"
   ],
   "text": "Then verify the notice, receipt, form, service, end date, and stated termination type."
  },
  {
   "source_refs": [
    "policy-lease_termination_dispute-v1#policy-lease_termination_dispute-v1.clause-03"
   ],
   "text": "Apply arrears, family-home, retaliation, and hardship evidence only when that branch is active."
  },
  {
   "source_refs": [
    "policy-lease_termination_dispute-v1#policy-lease_termination_dispute-v1.clause-04"
   ],
   "text": "Separate formal validity, factual grounds, extension, and settlement questions."
  },
  {
   "source_refs": [
    "policy-lease_termination_dispute-v1#policy-lease_termination_dispute-v1.clause-05"
   ],
   "text": "Request only missing evidence that changes one of those decisions."
  },
  {
   "source_refs": [
    "policy-lease_termination_dispute-v1#policy-lease_termination_dispute-v1.clause-silence"
   ],
   "text": "Silence policy: a branch fact that the claim never mentions is presumed absent; the dispute's defining event (for a termination dispute, that a termination notice was received; for a rent dispute, that a rent-increase notification was received) is presumed to have occurred; a fact that the claim raises but leaves open is unresolved, and the documents that depend on it are held behind a question."
  }
 ],
