{
 "format": "study3-spec/1",
 "status": "DRAFT. Items listed under open_items are fixed before ANALYSIS_PLAN_STUDY3.md is committed. analysis/study3.py reads everything below; nothing here is repeated in code.",
 "open_items": [
  "hypotheses: final order and comparators after round 4 (STUDY3_DESIGN.md section 6)",
  "designs.*.store.fresh2: file names the runners will write (defaults below follow one folder per run label)",
  "designs.self_consistency: number of samples per run (draft: 5) and whether the Rules in context runs count as samples",
  "designs.core.cost.multiplier: readings paid per text-run (development: 2, two readings per run)",
  "product_evaluator: worktree of the frozen product commit and the converted fresh2 catalogues",
  "tenancy_subsets.defining_event_false: the definition (draft: empty request set and no held document)"
 ],
 "statistics": {
  "alpha": 0.05,
  "significant_if": "p below alpha",
  "bootstrap_resamples": 10000,
  "seed": 20261111,
  "signflip": "exact two-sided; a 'fewer' hypothesis also needs the difference in the predicted direction",
  "noninferiority": "paired cluster bootstrap; p = share of resamples whose difference (A - B) reaches the margin"
 },
 "regimes": {
  "tenancy": {"cluster": "family_id", "cluster_label": "families", "unit": "claim"},
  "theft": {"cluster": "condition", "cluster_label": "changed facts", "unit": "changed-fact pair"}
 },
 "data": {
  "fresh": {"label": "Study 2 data, development data since Study 2", "theft_stories": null},
  "fresh2": {"label": "Study 3 sealed data", "theft_stories": null}
 },
 "measures": {
  "strict_unsafe": {"regime": "tenancy", "label": "strict unsafe errors per claim", "higher_is_better": false},
  "all_deviations": {"regime": "tenancy", "label": "all deviations per claim", "higher_is_better": false},
  "requested_share": {"regime": "tenancy", "label": "requested share of required-now documents", "higher_is_better": true},
  "errors": {"regime": "theft", "label": "wrong + missed changes per pair", "higher_is_better": false},
  "errors_dedup": {"regime": "theft", "label": "wrong + missed per pair, repeated errors once per story and run", "higher_is_better": false}
 },
