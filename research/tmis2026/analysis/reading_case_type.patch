diff --git a/casepath-internal/tests/test_reading_case_type.py b/casepath-internal/tests/test_reading_case_type.py
new file mode 100644
index 0000000..e577f21
--- /dev/null
+++ b/casepath-internal/tests/test_reading_case_type.py
@@ -0,0 +1,44 @@
+import unittest
+
+from casepath.agents.team import READING_CASE_TYPE, CaseTeam, CaseWork, confirm_facts, read_facts
+from casepath.config import load_settings
+from casepath.parity import manifest, non_default_settings
+from tests.scripted import ScriptedModel
+from tests.test_team import CASE, FILES, FIXTURE
+
+
+def reading_instructions(on):
+    work = CaseWork(case=CASE, files=FILES, base_workflow=FIXTURE)
+    work.reading_case_type = on
+    model = ScriptedModel([])
+    seen, original = [], model.respond_json
+    model.respond_json = lambda **kw: seen.append(kw) or original(**kw)
+    read_facts(model, work)
+    confirm_facts(model, work)
+    return [kw["instructions"] for kw in seen if kw["name"].startswith(("casepath_read_facts", "casepath_confirm_facts"))], work
+
+
+class ReadingCaseTypeTest(unittest.TestCase):
+    def test_off_by_default_and_named_when_on(self):
+        self.assertFalse(load_settings({}).reading_case_type)
+        on = load_settings({"CASEPATH_READING_CASE_TYPE": "true"})
+        self.assertTrue(on.reading_case_type)
+        self.assertTrue(manifest(on)["settings"]["reading_case_type"])
+        self.assertIn("reading_case_type", non_default_settings(on))
+        self.assertFalse(CaseTeam(ScriptedModel([])).reading_case_type)
+        self.assertTrue(CaseTeam(ScriptedModel([]), reading_case_type=True).reading_case_type)
+
+    def test_every_reading_gets_the_case_type_rule_only_when_on(self):
+        off, work = reading_instructions(False)
+        on, _ = reading_instructions(True)
+        self.assertTrue(off and on and len(off) == len(on))
+        title = work.graph["title"]
+        for text in off:  # off: the request is the branch's own, unchanged
+            self.assertNotIn(READING_CASE_TYPE, text)
+            self.assertIn(f"\n\nThe case is a {title}. Conditions:\n", text)
+        for text in on:
+            self.assertIn(f"\n\nCase type: {title}.\n" + READING_CASE_TYPE + " Conditions:\n", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
