receipt = {**payload, "receipt_sha256": digest_bytes(canonical(payload))}
encoded = json.dumps(receipt, indent=2, ensure_ascii=False, sort_keys=True).encode("utf-8") + b"\n"
fault_point = os.environ.get("CASEPATH_LAUNCH_FAULT_POINT") or None
if fault_point not in (None, "after_staging_fsync", "after_history_link", "after_current_replace"):
    raise SystemExit(f"CasePath launch fault point is invalid: {fault_point}")
history = runtime / "boots" / f"{boot_id}.json"
staging = runtime / "boot-staging" / f".{boot_id}.{os.getpid()}.{uuid.uuid4()}.tmp"
with staging.open("xb") as stream:
    stream.write(encoded)
    stream.flush()
    os.fsync(stream.fileno())
os.chmod(staging, 0o444)
descriptor = os.open(staging, os.O_RDONLY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
if fault_point == "after_staging_fsync":
    raise SystemExit("CasePath injected crash after staging fsync")
os.link(staging, history)
descriptor = os.open(runtime / "boots", os.O_RDONLY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
staging.unlink()
descriptor = os.open(runtime / "boot-staging", os.O_RDONLY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
if fault_point == "after_history_link":
    raise SystemExit("CasePath injected crash after immutable history publication")
temporary = runtime / f".runtime-boot-receipt.{os.getpid()}.{uuid.uuid4()}.tmp"
with temporary.open("xb") as stream:
    stream.write(encoded)
    stream.flush()
    os.fsync(stream.fileno())
os.replace(temporary, current_receipt)
for directory in (runtime,):
    descriptor = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
if fault_point == "after_current_replace":
    raise SystemExit("CasePath injected crash after current receipt replacement")
