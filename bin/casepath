            source_manifest_after_ready_sha256
        ),
        "artifact_manifest_file_sha256": digest_file(
            execution_root / "casepath-api/artifacts/artifact-manifest.json"
        ),
    },
    "runtime": {
        "python_path": str(python_stated),
        "python_real_path": str(python),
        "python_file_sha256": digest_file(python),
        "python_version": platform.python_version(),
        "requirements_lock_sha256": digest_file(
            execution_root / "casepath-api/requirements.lock"
        ),
        "installed_distributions": distributions,
        "installed_distributions_sha256": digest_bytes(canonical(distributions)),
        "data_root": str(data_root),
        "data_root_provenance_file_sha256": digest_file(
            data_root / "DATA_ROOT_PROVENANCE.json"
