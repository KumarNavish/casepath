def load_runtime_closure(path: Path) -> dict[str, object]:
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0),
    )
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
            raise SystemExit("CasePath runtime closure capture is not regular")
        chunks = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
    finally:
        os.close(descriptor)
    try:
        value = json.loads(b"".join(chunks))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SystemExit("CasePath runtime closure capture is invalid") from exc
    if (
        not isinstance(value, dict)
        or set(value)
        != {
            "contract",
            "claim_boundary",
            "sections",
            "subordinate_closure_sha256",
            "closure_sha256",
        }
        or value.get("contract") != "casepath.executable-runtime-closure/1.1.0"
        or value.get("claim_boundary")
        != (
            "exact_active_capsule_python_entry_real_executable_isolated_path_environment_"
            "and_complete_site_packages;cpython_stdlib_tree_and_original_wheel_archives_"
            "not_captured"
        )
    ):
        raise SystemExit("CasePath runtime closure capture schema is invalid")
    semantic = dict(value)
    stated = semantic.pop("closure_sha256")
    if stated != digest_bytes(canonical(semantic)):
        raise SystemExit("CasePath runtime closure capture self-hash is invalid")
    sections = value.get("sections")
    subordinate = value.get("subordinate_closure_sha256")
    expected_names = {
        "capsule",
        "distribution_integrity",
        "isolated_probe",
        "launch_context",
        "python_runtime",
        "site_packages",
    }
    if (
        not isinstance(sections, dict)
        or set(sections) != expected_names
        or not isinstance(subordinate, dict)
        or set(subordinate) != expected_names
    ):
        raise SystemExit("CasePath runtime subordinate closure roster is invalid")
    for name in sorted(expected_names):
        section = sections[name]
        if not isinstance(section, dict):
            raise SystemExit("CasePath runtime subordinate closure is invalid")
        section_semantic = dict(section)
        section_stated = section_semantic.pop("closure_sha256", None)
        if (
            section_stated != digest_bytes(canonical(section_semantic))
            or subordinate.get(name) != section_stated
        ):
            raise SystemExit("CasePath runtime subordinate closure hash is invalid")
    return value


closure_captures = [
    ("after_sync", load_runtime_closure(runtime_closure_after_sync_path)),
    ("before_child", load_runtime_closure(runtime_closure_before_child_path)),
    ("after_ready", load_runtime_closure(runtime_closure_after_ready_path)),
]
