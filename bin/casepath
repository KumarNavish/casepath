        "model_ledger_response_sha256": digest_bytes(ledger_raw),
        "root_html_sha256": digest_bytes(root_raw),
        "workspace_seed_receipt_file_sha256": digest_bytes(seed_raw),
        "workspace_seed_receipt_base64": base64.b64encode(seed_raw).decode("ascii"),
        "workspace_seed_receipt_sha256": seed_wrapper_sha,
        "workspace_seed_event_roster_sha256": seed["event_roster_sha256"],
        "workspace_response_sha256": digest_bytes(workspace_raw),
        "workspace_response_base64": base64.b64encode(workspace_raw).decode("ascii"),
        "workspace_projection_sha256": workspace_projection_sha,
