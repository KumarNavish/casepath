        "execution_root": str(execution_root),
        "source_capsule_receipt_file_sha256": digest_file(
            execution_root / "CAPSULE_RECEIPT.json"
        ),
        "source_manifest_path": "casepath/source-manifest.json",
        "source_manifest_before_child_sha256": (
            source_manifest_before_child_sha256
        ),
        "source_manifest_file_sha256": digest_file(
            repository / "casepath/source-manifest.json"
        ),
