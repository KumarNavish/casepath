#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
invocation_directory="${CASEPATH_INVOCATION_DIRECTORY:-$(pwd -P)}"
cd "$repository_root"
export PYTHONDONTWRITEBYTECODE=1
runtime_root="$repository_root/.runtime/casepath-dev-v2"
data_root="$repository_root/.runtime/casepath-data-v1"
legacy_data_root="$repository_root/.runtime/casepath-dev-v1"
venv_root="$runtime_root/venv"
python_command="$venv_root/bin/python"
uv_command="${CASEPATH_UV:-}"
port="4173"
url="http://127.0.0.1:${port}/"
child_pid=""

ensure_private_runtime_root() {
  local mutable_parent="$repository_root/.runtime"
  local candidate=""
  for candidate in "$mutable_parent" "$runtime_root"; do
    if [[ -L "$candidate" ]]; then
      printf 'CasePath command failed: mutable runtime boundary is a symlink\n' >&2
      exit 2
    fi
  done
  (umask 077; /bin/mkdir -p "$runtime_root")
  /bin/chmod 0700 "$mutable_parent" "$runtime_root"
  for candidate in "$mutable_parent" "$runtime_root"; do
    if [[ ! -d "$candidate" || -L "$candidate" ]]; then
      printf 'CasePath command failed: mutable runtime boundary is not private\n' >&2
      exit 2
    fi
  done
}

ensure_private_runtime_directories() {
  local directories=(
    "$runtime_root/home"
    "$runtime_root/tmp"
    "$runtime_root/pycache"
    "$runtime_root/boots"
    "$runtime_root/boot-staging"
  )
  local candidate=""
  ensure_private_runtime_root
  for candidate in "${directories[@]}"; do
    if [[ -L "$candidate" ]]; then
      printf 'CasePath command failed: mutable runtime directory is a symlink\n' >&2
      exit 2
    fi
  done
  (umask 077; /bin/mkdir -p "${directories[@]}")
  /bin/chmod 0700 "${directories[@]}"
  for candidate in "${directories[@]}"; do
    if [[ ! -d "$candidate" || -L "$candidate" ]]; then
      printf 'CasePath command failed: mutable runtime directory is not private\n' >&2
      exit 2
    fi
  done
}

run_clean_stdlib_python() {
  /usr/bin/env -i \
    HOME="$runtime_root/home" \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH="$venv_root/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    PYTHONHASHSEED=0 \
    PYTHONNOUSERSITE=1 \
    PYTHONSAFEPATH=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPYCACHEPREFIX="$runtime_root/pycache" \
    TZ=UTC \
    "$python_command" -I -S -B -P "$@"
}

verify_sealed_source_tree() {
  local verification_mode="${1:-complete}"
  run_clean_stdlib_python - "$repository_root" "$verification_mode" <<'PY'
from __future__ import annotations

import hashlib
import json
from pathlib import Path
import re
import stat
import subprocess
import sys

repository = Path(sys.argv[1]).resolve()
verification_mode = sys.argv[2]
if verification_mode not in {"source-only", "complete"}:
    raise SystemExit("CasePath sealed source verification mode is invalid")
manifest_path = repository / "casepath/source-manifest.json"
if manifest_path.is_symlink() or not manifest_path.is_file():
    raise SystemExit("CasePath sealed source manifest is not regular")
try:
    manifest_raw = manifest_path.read_bytes()
    manifest = json.loads(manifest_raw)
except (UnicodeDecodeError, json.JSONDecodeError) as exc:
    raise SystemExit("CasePath sealed source manifest is invalid") from exc
rows = manifest.get("files") if isinstance(manifest, dict) else None
source_roots = ["casepath", "casepath-api", "casepath-qa", "docs", "examples"]
extra_files = [
    ".gitattributes",
    ".gitignore",
    "AGENTS.md",
    "bin/casepath",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "CASEPATH_MASTER_KNOWLEDGE_TRANSFER.md",
]
if (
    not isinstance(manifest, dict)
    or set(manifest)
    != {
        "artifact_manifest",
        "contract",
        "file_count",
        "files",
        "gate_count",
        "gates",
        "inventory_policy",
        "release_id",
    }
    or manifest.get("contract") != "casepath.source-manifest/2.1.0"
    or manifest.get("release_id") != "casepath-v20-reference-20260811"
    or manifest.get("inventory_policy")
    != {
        "includes_nonignored_pending_files": True,
        "roots": [*source_roots, *extra_files],
        "self_output_excluded": "casepath/source-manifest.json",
    }
    or not isinstance(rows, list)
    or manifest.get("file_count") != len(rows)
):
    raise SystemExit("CasePath sealed source manifest is invalid")
paths: list[str] = []
row_by_path: dict[str, dict[str, object]] = {}
for row in rows:
    if (
        not isinstance(row, dict)
        or set(row) != {"executable", "path", "sha256", "size_bytes"}
        or type(row.get("executable")) is not bool
        or not isinstance(row.get("path"), str)
        or not row["path"]
        or Path(row["path"]).is_absolute()
        or Path(row["path"]).as_posix() != row["path"]
        or any(part in {"", ".", ".."} for part in Path(row["path"]).parts)
        or not isinstance(row.get("sha256"), str)
        or len(row["sha256"]) != 64
        or type(row.get("size_bytes")) is not int
        or row["size_bytes"] < 0
        or row["path"] in row_by_path
    ):
        raise SystemExit("CasePath sealed source manifest row is invalid")
    path = repository / row["path"]
    try:
        metadata = path.lstat()
    except OSError as exc:
        raise SystemExit("CasePath sealed source file is absent") from exc
    if path.is_symlink() or not stat.S_ISREG(metadata.st_mode):
        raise SystemExit("CasePath sealed source file is not regular")
    raw = path.read_bytes()
    if row != {
        "executable": bool(metadata.st_mode & stat.S_IXUSR),
        "path": row["path"],
        "sha256": hashlib.sha256(raw).hexdigest(),
        "size_bytes": len(raw),
    }:
        raise SystemExit("CasePath sealed source file identity differs from disk")
    paths.append(row["path"])
    row_by_path[row["path"]] = row
if paths != sorted(paths):
    raise SystemExit("CasePath sealed source roster is not canonical")
git_authority = repository / ".git"
if git_authority.is_symlink() or (
    git_authority.exists() and not git_authority.is_dir()
):
    raise SystemExit("CasePath canonical Git source authority is invalid")
if git_authority.is_dir():
    try:
        candidates = subprocess.check_output(
            [
                "/usr/bin/git",
                "ls-files",
                "--cached",
                "--others",
                "--exclude-standard",
                "--",
                *source_roots,
                *extra_files,
            ],
            cwd=repository,
            text=True,
            stderr=subprocess.DEVNULL,
        ).splitlines()
    except (OSError, subprocess.CalledProcessError) as exc:
        raise SystemExit("CasePath sealed source inventory cannot be resolved") from exc
else:
    candidates = []
    for root_name in source_roots:
        root = repository / root_name
        if root.is_symlink() or not root.is_dir():
            raise SystemExit("CasePath archive source root is invalid")
        for path in root.rglob("*"):
            metadata = path.lstat()
            if path.is_symlink() or (
                not stat.S_ISREG(metadata.st_mode)
                and not stat.S_ISDIR(metadata.st_mode)
            ):
                raise SystemExit("CasePath archive source inventory is invalid")
            if stat.S_ISREG(metadata.st_mode):
                candidates.append(path.relative_to(repository).as_posix())
    candidates.extend(extra_files)
actual_paths = []
for candidate in candidates:
    normalized = Path(candidate).as_posix()
    if (
        normalized in {"casepath/deployment.json", "casepath/source-manifest.json"}
        or normalized.startswith("casepath-api/artifacts/")
        or "__pycache__" in Path(normalized).parts
        or Path(normalized).suffix in {".pyc", ".pyo"}
    ):
        continue
    candidate_path = repository / normalized
    try:
        candidate_metadata = candidate_path.lstat()
    except OSError as exc:
        raise SystemExit("CasePath sealed source inventory contains an absent path") from exc
    if candidate_path.is_symlink() or not stat.S_ISREG(candidate_metadata.st_mode):
        raise SystemExit("CasePath sealed source inventory contains a non-regular path")
    actual_paths.append(normalized)
if paths != sorted(set(actual_paths)):
    raise SystemExit("CasePath sealed source roster is incomplete")
artifact = manifest.get("artifact_manifest")
artifact_path = repository / "casepath-api/artifacts/artifact-manifest.json"
if (
    not isinstance(artifact, dict)
    or set(artifact) != {"model_visible_files", "path", "sha256"}
    or artifact.get("path") != "casepath-api/artifacts/artifact-manifest.json"
    or (
        verification_mode == "complete"
        and (
            artifact_path.is_symlink()
            or not artifact_path.is_file()
            or artifact.get("sha256")
            != hashlib.sha256(artifact_path.read_bytes()).hexdigest()
        )
    )
):
    raise SystemExit("CasePath sealed artifact authority is invalid")
expected_gates = [
    {"path": path, "sha256": row_by_path[path]["sha256"]}
    for path in paths
    if path.startswith("casepath-qa/")
    and Path(path).suffix in {".mjs", ".py"}
    and Path(path).name.startswith(("browser-", "check-", "reset-", "patch_"))
]
if (
    manifest.get("gates") != expected_gates
    or manifest.get("gate_count") != len(expected_gates)
):
    raise SystemExit("CasePath sealed gate authority is invalid")
print(hashlib.sha256(manifest_raw).hexdigest())
PY
}

materialize_sealed_source_capsule() {
  local expected_manifest_sha256="$1"
  run_clean_stdlib_python - "$repository_root" "$runtime_root" \
    "$expected_manifest_sha256" <<'PY'
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import uuid

repository = Path(sys.argv[1]).resolve()
runtime = Path(sys.argv[2]).resolve()
expected_manifest_sha256 = sys.argv[3]
capsules = runtime / "source-capsules"


def durable_mkdir(path: Path, mode: int = 0o700) -> None:
    missing = []
    candidate = path
    while not candidate.exists():
        missing.append(candidate)
        candidate = candidate.parent
    for directory in reversed(missing):
        directory.mkdir(mode=mode)
        parent_descriptor = os.open(directory.parent, os.O_RDONLY)
        try:
            os.fsync(parent_descriptor)
        finally:
            os.close(parent_descriptor)
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


durable_mkdir(capsules)
if capsules.is_symlink() or not capsules.is_dir():
    raise SystemExit("CasePath source capsule root is invalid")


def canonical(value: object) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")


def digest(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def read_regular(path: Path) -> tuple[bytes, os.stat_result]:
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0),
    )
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise SystemExit(f"CasePath capsule source is not regular: {path}")
        chunks = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                return b"".join(chunks), metadata
            chunks.append(chunk)
    finally:
        os.close(descriptor)


def write_file(path: Path, raw: bytes, *, executable: bool) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        view = memoryview(raw)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise SystemExit("CasePath capsule publication made no progress")
            view = view[written:]
        os.fchmod(descriptor, 0o755 if executable else 0o644)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.utime(path, (1786406400, 1786406400), follow_symlinks=False)


def validate_row(row: object) -> dict[str, object]:
    if (
        not isinstance(row, dict)
        or set(row) != {"executable", "path", "sha256", "size_bytes"}
        or type(row.get("executable")) is not bool
        or not isinstance(row.get("path"), str)
        or not row["path"]
        or Path(row["path"]).is_absolute()
        or Path(row["path"]).as_posix() != row["path"]
        or any(part in {"", ".", ".."} for part in Path(row["path"]).parts)
        or not isinstance(row.get("sha256"), str)
        or len(row["sha256"]) != 64
        or type(row.get("size_bytes")) is not int
        or row["size_bytes"] < 0
    ):
        raise SystemExit("CasePath capsule source row is invalid")
    return row


manifest_raw, _ = read_regular(repository / "casepath/source-manifest.json")
if digest(manifest_raw) != expected_manifest_sha256:
    raise SystemExit("CasePath source changed after sealed preflight")
try:
    manifest = json.loads(manifest_raw)
except (UnicodeDecodeError, json.JSONDecodeError) as exc:
    raise SystemExit("CasePath capsule source manifest is invalid") from exc
rows_raw = manifest.get("files") if isinstance(manifest, dict) else None
if not isinstance(rows_raw, list):
    raise SystemExit("CasePath capsule source manifest is invalid")
rows = [validate_row(row) for row in rows_raw]
if [row["path"] for row in rows] != sorted(row["path"] for row in rows):
    raise SystemExit("CasePath capsule source roster is not canonical")

artifact_binding = manifest.get("artifact_manifest")
artifact_manifest_path = repository / "casepath-api/artifacts/artifact-manifest.json"
artifact_manifest_raw, _ = read_regular(artifact_manifest_path)
if (
    not isinstance(artifact_binding, dict)
    or artifact_binding.get("path")
    != "casepath-api/artifacts/artifact-manifest.json"
    or artifact_binding.get("sha256") != digest(artifact_manifest_raw)
):
    raise SystemExit("CasePath capsule artifact authority differs from source")
try:
    artifact_manifest = json.loads(artifact_manifest_raw)
except (UnicodeDecodeError, json.JSONDecodeError) as exc:
    raise SystemExit("CasePath capsule artifact manifest is invalid") from exc
artifact_rows = artifact_manifest.get("files") if isinstance(artifact_manifest, dict) else None
if (
    not isinstance(artifact_rows, list)
    or artifact_manifest.get("file_count") != len(artifact_rows)
):
    raise SystemExit("CasePath capsule artifact manifest is invalid")

static_root = repository / "casepath-public"
if static_root.is_symlink() or not static_root.is_dir():
    raise SystemExit("CasePath capsule built product is invalid")
static_rows = []
for path in sorted(static_root.rglob("*")):
    if path.is_symlink() or (not path.is_file() and not path.is_dir()):
        raise SystemExit("CasePath capsule built product contains an invalid entry")
    if path.is_file():
        raw, metadata = read_regular(path)
        static_rows.append(
            {
                "path": path.relative_to(static_root).as_posix(),
                "sha256": digest(raw),
                "size_bytes": len(raw),
                "executable": bool(metadata.st_mode & stat.S_IXUSR),
            }
        )
if not static_rows:
    raise SystemExit("CasePath capsule built product is empty")

source_roster_sha256 = digest(canonical(rows))
static_inventory_sha256 = digest(canonical(static_rows))
target = capsules / expected_manifest_sha256
receipt_path = target / "CAPSULE_RECEIPT.json"


def validate_capsule() -> None:
    acl_present = False
    if sys.platform == "darwin":
        try:
            acl_listing = "\n".join(
                (
                    subprocess.check_output(
                        ["/bin/ls", "-lde", "--", str(target)],
                        text=True,
                        stderr=subprocess.STDOUT,
                    ),
                    subprocess.check_output(
                        ["/bin/ls", "-lAeR", "--", str(target)],
                        text=True,
                        stderr=subprocess.STDOUT,
                    ),
                )
            )
        except (OSError, subprocess.CalledProcessError) as exc:
            raise SystemExit(
                "CasePath existing source capsule ACL authority is unavailable"
            ) from exc
        acl_present = bool(
            __import__("re").search(
                r"^[bcdlps-][rwxStTs-]{9}\+", acl_listing, __import__("re").MULTILINE
            )
            or __import__("re").search(
                r"^\s*\d+:\s", acl_listing, __import__("re").MULTILINE
            )
        )
    elif sys.platform.startswith("linux"):
        try:
            acl_present = any(
                attribute
                in {"system.posix_acl_access", "system.posix_acl_default"}
                for attribute in os.listxattr(target, follow_symlinks=False)
            )
        except OSError as exc:
            raise SystemExit(
                "CasePath existing source capsule ACL authority is unavailable"
            ) from exc
    if (
        stat.S_IMODE(target.stat().st_mode) != 0o500
        or acl_present
    ):
        raise SystemExit("CasePath existing source capsule is writable")
    receipt_raw, _ = read_regular(receipt_path)
    try:
        receipt = json.loads(receipt_raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SystemExit("CasePath existing source capsule receipt is invalid") from exc
    semantic = dict(receipt) if isinstance(receipt, dict) else {}
    stated = semantic.pop("receipt_sha256", None)
    if (
        not isinstance(receipt, dict)
        or set(receipt)
        != {
            "contract",
            "source_manifest_file_sha256",
            "source_roster_sha256",
            "source_file_count",
            "artifact_manifest_file_sha256",
            "artifact_file_count",
            "static_inventory_sha256",
            "static_file_count",
            "receipt_sha256",
        }
        or receipt.get("contract") != "casepath.sealed-source-capsule/1.0.0"
        or receipt.get("source_manifest_file_sha256")
        != expected_manifest_sha256
        or receipt.get("source_roster_sha256") != source_roster_sha256
        or receipt.get("source_file_count") != len(rows)
        or receipt.get("artifact_manifest_file_sha256")
        != digest(artifact_manifest_raw)
        or receipt.get("artifact_file_count") != len(artifact_rows)
        or receipt.get("static_inventory_sha256") != static_inventory_sha256
        or receipt.get("static_file_count") != len(static_rows)
        or stated != digest(canonical(semantic))
    ):
        raise SystemExit("CasePath existing source capsule receipt is invalid")
    expected = {
        row["path"]: row for row in rows
    }
    expected["casepath/source-manifest.json"] = {
        "executable": False,
        "path": "casepath/source-manifest.json",
        "sha256": expected_manifest_sha256,
        "size_bytes": len(manifest_raw),
    }
    expected["casepath-api/artifacts/artifact-manifest.json"] = {
        "executable": False,
        "path": "casepath-api/artifacts/artifact-manifest.json",
        "sha256": digest(artifact_manifest_raw),
        "size_bytes": len(artifact_manifest_raw),
    }
    for artifact_row in artifact_rows:
        if (
            not isinstance(artifact_row, dict)
            or not isinstance(artifact_row.get("path"), str)
            or Path(artifact_row["path"]).is_absolute()
            or ".." in Path(artifact_row["path"]).parts
            or not isinstance(artifact_row.get("sha256"), str)
            or type(artifact_row.get("size_bytes")) is not int
        ):
            raise SystemExit("CasePath capsule artifact row is invalid")
        relative = f"casepath-api/artifacts/{artifact_row['path']}"
        expected[relative] = {
            "executable": False,
            "path": relative,
            "sha256": artifact_row["sha256"],
            "size_bytes": artifact_row["size_bytes"],
        }
    for static_row in static_rows:
        relative = f"casepath-public/{static_row['path']}"
        expected[relative] = {**static_row, "path": relative}
    actual = []
    actual_directories = []
    for candidate in sorted(target.rglob("*")):
        if candidate.is_symlink() or (
            not candidate.is_file() and not candidate.is_dir()
        ):
            raise SystemExit("CasePath existing source capsule has an invalid entry")
        candidate_metadata = candidate.stat()
        if sys.platform.startswith("linux"):
            try:
                candidate_acl = any(
                    attribute
                    in {"system.posix_acl_access", "system.posix_acl_default"}
                    for attribute in os.listxattr(
                        candidate, follow_symlinks=False
                    )
                )
            except OSError as exc:
                raise SystemExit(
                    "CasePath existing source capsule ACL authority is unavailable"
                ) from exc
            if candidate_acl:
                raise SystemExit(
                    "CasePath existing source capsule contains an ACL"
                )
        if candidate.is_file():
            if candidate_metadata.st_nlink != 1:
                raise SystemExit(
                    "CasePath existing source capsule contains a linked file"
                )
            actual.append(candidate.relative_to(target).as_posix())
        if candidate.is_dir():
            if stat.S_IMODE(candidate_metadata.st_mode) != 0o500:
                raise SystemExit(
                    "CasePath existing source capsule directory mode is invalid"
                )
            actual_directories.append(candidate.relative_to(target).as_posix())
    actual.sort()
    if actual != sorted([*expected, "CAPSULE_RECEIPT.json"]):
        raise SystemExit("CasePath existing source capsule roster is not exact")
    expected_directories = set()
    for relative in [*expected, "CAPSULE_RECEIPT.json"]:
        parts = Path(relative).parts
        for index in range(1, len(parts)):
            expected_directories.add(Path(*parts[:index]).as_posix())
    if sorted(actual_directories) != sorted(expected_directories):
        raise SystemExit(
            "CasePath existing source capsule directory roster is not exact"
        )
    for relative, row in expected.items():
        raw, metadata = read_regular(target / relative)
        expected_mode = 0o555 if row["executable"] else 0o444
        if row != {
            "executable": bool(metadata.st_mode & stat.S_IXUSR),
            "path": relative,
            "sha256": digest(raw),
            "size_bytes": len(raw),
        } or stat.S_IMODE(metadata.st_mode) != expected_mode:
            raise SystemExit("CasePath existing source capsule differs from authority")


if target.exists():
    if target.is_symlink() or not target.is_dir():
        raise SystemExit("CasePath source capsule destination is invalid")
    validate_capsule()
    print(target)
    raise SystemExit(0)

staging = capsules / f".{expected_manifest_sha256}.{os.getpid()}.{uuid.uuid4()}.tmp"
try:
    staging.mkdir(mode=0o700)
    for row in rows:
        raw, metadata = read_regular(repository / row["path"])
        if row != {
            "executable": bool(metadata.st_mode & stat.S_IXUSR),
            "path": row["path"],
            "sha256": digest(raw),
            "size_bytes": len(raw),
        }:
            raise SystemExit("CasePath source changed while capsule was captured")
        write_file(staging / row["path"], raw, executable=row["executable"])
    write_file(
        staging / "casepath/source-manifest.json",
        manifest_raw,
        executable=False,
    )
    write_file(
        staging / "casepath-api/artifacts/artifact-manifest.json",
        artifact_manifest_raw,
        executable=False,
    )
    copied_artifact_paths = []
    for artifact_row in artifact_rows:
        if (
            not isinstance(artifact_row, dict)
            or not isinstance(artifact_row.get("path"), str)
            or Path(artifact_row["path"]).is_absolute()
            or ".." in Path(artifact_row["path"]).parts
            or not isinstance(artifact_row.get("sha256"), str)
            or type(artifact_row.get("size_bytes")) is not int
            or artifact_row["path"] in copied_artifact_paths
        ):
            raise SystemExit("CasePath capsule artifact row is invalid")
        raw, _ = read_regular(
            repository / "casepath-api/artifacts" / artifact_row["path"]
        )
        if (
            artifact_row["sha256"] != digest(raw)
            or artifact_row["size_bytes"] != len(raw)
        ):
            raise SystemExit("CasePath artifact changed while capsule was captured")
        write_file(
            staging / "casepath-api/artifacts" / artifact_row["path"],
            raw,
            executable=False,
        )
        copied_artifact_paths.append(artifact_row["path"])
    if copied_artifact_paths != sorted(copied_artifact_paths):
        raise SystemExit("CasePath capsule artifact roster is not canonical")
    for static_row in static_rows:
        raw, metadata = read_regular(static_root / static_row["path"])
        if static_row != {
            "path": static_row["path"],
            "sha256": digest(raw),
            "size_bytes": len(raw),
            "executable": bool(metadata.st_mode & stat.S_IXUSR),
        }:
            raise SystemExit("CasePath built product changed during capsule capture")
        write_file(
            staging / "casepath-public" / static_row["path"],
            raw,
            executable=static_row["executable"],
        )
    material = {
        "contract": "casepath.sealed-source-capsule/1.0.0",
        "source_manifest_file_sha256": expected_manifest_sha256,
        "source_roster_sha256": source_roster_sha256,
        "source_file_count": len(rows),
        "artifact_manifest_file_sha256": digest(artifact_manifest_raw),
        "artifact_file_count": len(artifact_rows),
        "static_inventory_sha256": static_inventory_sha256,
        "static_file_count": len(static_rows),
    }
    receipt = {**material, "receipt_sha256": digest(canonical(material))}
    write_file(
        staging / "CAPSULE_RECEIPT.json",
        json.dumps(receipt, indent=2, ensure_ascii=False, sort_keys=True).encode()
        + b"\n",
        executable=False,
    )
    for file_path in sorted(path for path in staging.rglob("*") if path.is_file()):
        os.chmod(
            file_path,
            0o555 if file_path.stat().st_mode & stat.S_IXUSR else 0o444,
        )
        descriptor = os.open(
            file_path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        )
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    for directory in sorted(
        (path for path in staging.rglob("*") if path.is_dir()), reverse=True
    ):
        os.chmod(directory, 0o500)
        descriptor = os.open(directory, os.O_RDONLY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    os.chmod(staging, 0o500)
    descriptor = os.open(staging, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.rename(staging, target)
    descriptor = os.open(capsules, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    validate_capsule()
finally:
    if staging.exists():
        for candidate in [staging, *staging.rglob("*")]:
            try:
                os.chmod(
                    candidate,
                    stat.S_IMODE(candidate.stat().st_mode) | 0o200,
                )
            except OSError:
                pass
        shutil.rmtree(staging)
print(target)
PY
}

run_clean_locked_python() {
  /usr/bin/env -i \
    HOME="$runtime_root/home" \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH="$venv_root/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    PYTHONHASHSEED=0 \
    PYTHONNOUSERSITE=1 \
    PYTHONSAFEPATH=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPYCACHEPREFIX="$runtime_root/pycache" \
    SOURCE_DATE_EPOCH=1786406400 \
    TMPDIR="$runtime_root/tmp" \
    TZ=UTC \
    CASEPATH_LAUNCH_FAULT_POINT="${CASEPATH_LAUNCH_FAULT_POINT:-}" \
    CASEPATH_SOURCE_COMMIT="${CASEPATH_SOURCE_COMMIT:-}" \
    CASEPATH_SOURCE_BRANCH="${CASEPATH_SOURCE_BRANCH:-}" \
    "$python_command" -I -B -P "$@"
}

# Capture the executable inputs that the product and the Gate 2 permutation
# subprocess can actually load.  This deliberately makes no whole-host or
# whole-CPython-install claim: the closed surface is the immutable application
# capsule, the active interpreter identity, and the complete venv site-packages
# tree together with its distribution RECORD authority.
capture_runtime_closure() {
  local execution_root="$1"
  local output_path="$2"
  run_clean_stdlib_python - "$repository_root" "$runtime_root" \
    "$execution_root" "$python_command" "$output_path" \
    "$CASEPATH_SOURCE_COMMIT" <<'PY'
from __future__ import annotations

import base64
import csv
from email import policy
from email.parser import BytesParser
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import posixpath
import platform
import re
import stat
import subprocess
import sys


repository = Path(sys.argv[1]).resolve()
runtime = Path(sys.argv[2]).resolve()
execution_root = Path(sys.argv[3]).resolve()
python_stated = Path(os.path.abspath(sys.argv[4]))
output_path = Path(sys.argv[5])
source_commit = sys.argv[6]
venv = runtime / "venv"


def canonical(value: object) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")


def digest(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def read_regular(path: Path) -> tuple[bytes, os.stat_result]:
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0),
    )
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
            raise SystemExit(f"CasePath runtime closure file is not single-link regular: {path}")
        chunks: list[bytes] = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        after = os.fstat(descriptor)
        identity_before = (
            before.st_dev,
            before.st_ino,
            before.st_mode,
            before.st_uid,
            before.st_gid,
            before.st_size,
            before.st_mtime_ns,
        )
        identity_after = (
            after.st_dev,
            after.st_ino,
            after.st_mode,
            after.st_uid,
            after.st_gid,
            after.st_size,
            after.st_mtime_ns,
        )
        if identity_before != identity_after:
            raise SystemExit(f"CasePath runtime closure file changed while read: {path}")
        raw = b"".join(chunks)
        if len(raw) != before.st_size:
            raise SystemExit(f"CasePath runtime closure file size changed while read: {path}")
        return raw, before
    finally:
        os.close(descriptor)


def entry(path: Path, display_path: str) -> dict[str, object]:
    before = path.lstat()
    common = {
        "gid": before.st_gid,
        "mode": stat.S_IMODE(before.st_mode),
        "path": display_path,
        "uid": before.st_uid,
    }
    if stat.S_ISDIR(before.st_mode):
        return {"kind": "directory", **common}
    if stat.S_ISREG(before.st_mode):
        raw, metadata = read_regular(path)
        return {
            "kind": "file",
            **common,
            "sha256": digest(raw),
            "size_bytes": len(raw),
        }
    if stat.S_ISLNK(before.st_mode):
        target = os.readlink(path)
        after = path.lstat()
        if (
            before.st_dev,
            before.st_ino,
            before.st_mode,
            before.st_uid,
            before.st_gid,
        ) != (
            after.st_dev,
            after.st_ino,
            after.st_mode,
            after.st_uid,
            after.st_gid,
        ):
            raise SystemExit(f"CasePath runtime closure symlink changed while read: {path}")
        target_raw = os.fsencode(target)
        return {
            "kind": "symlink",
            **common,
            "target": target,
            "target_sha256": digest(target_raw),
            "target_size_bytes": len(target_raw),
        }
    raise SystemExit(f"CasePath runtime closure contains a special entry: {path}")


def close_section(material: dict[str, object]) -> dict[str, object]:
    return {**material, "closure_sha256": digest(canonical(material))}


def tree_section(root: Path) -> dict[str, object]:
    if root.is_symlink() or not root.is_dir() or root.resolve() != root:
        raise SystemExit(f"CasePath runtime closure tree root is invalid: {root}")
    roster = [entry(root, ".")]
    for candidate in sorted(root.rglob("*"), key=lambda value: value.relative_to(root).as_posix()):
        roster.append(entry(candidate, candidate.relative_to(root).as_posix()))
    material = {
        "root": str(root),
        "entry_count": len(roster),
        "roster": roster,
        "roster_sha256": digest(canonical(roster)),
    }
    return close_section(material)


probe_environment = {
    "HOME": str(runtime / "home"),
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "PATH": ":".join(
        (str(venv / "bin"), "/usr/bin", "/bin", "/usr/sbin", "/sbin")
    ),
    "PYTHONHASHSEED": "0",
    "PYTHONNOUSERSITE": "1",
    "PYTHONSAFEPATH": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONPYCACHEPREFIX": str(runtime / "pycache"),
    "TZ": "UTC",
}
probe_program = r'''
import importlib.util,json,os,platform,site,sys
names=("fastapi","pydantic","uvicorn")
origins={}
for name in names:
    spec=importlib.util.find_spec(name)
    origins[name]=None if spec is None else spec.origin
value={
    "argv":sys.argv,
    "base_exec_prefix":sys.base_exec_prefix,
    "base_prefix":sys.base_prefix,
    "enable_user_site":site.ENABLE_USER_SITE,
    "environment":dict(os.environ),
    "exec_prefix":sys.exec_prefix,
    "executable":sys.executable,
    "flags":{
        "dont_write_bytecode":bool(sys.flags.dont_write_bytecode),
        "ignore_environment":bool(sys.flags.ignore_environment),
        "isolated":bool(sys.flags.isolated),
        "no_site":bool(sys.flags.no_site),
        "no_user_site":bool(sys.flags.no_user_site),
        "safe_path":bool(sys.flags.safe_path),
    },
    "implementation":sys.implementation.name,
    "cache_tag":sys.implementation.cache_tag,
    "module_origins":origins,
    "path":sys.path,
    "prefix":sys.prefix,
    "python_build":list(platform.python_build()),
    "python_compiler":platform.python_compiler(),
    "python_version":platform.python_version(),
    "version_info":[
        sys.version_info.major,sys.version_info.minor,sys.version_info.micro,
        sys.version_info.releaselevel,sys.version_info.serial,
    ],
}
print(json.dumps(value,ensure_ascii=False,allow_nan=False,sort_keys=True,separators=(",",":")))
'''.strip()
completed = subprocess.run(
    [str(python_stated), "-I", "-B", "-P", "-c", probe_program],
    cwd=execution_root,
    env=probe_environment,
    check=False,
    capture_output=True,
    timeout=60,
)
if completed.returncode != 0 or completed.stderr:
    raise SystemExit("CasePath isolated runtime probe failed")
try:
    probe = json.loads(completed.stdout)
except (UnicodeDecodeError, json.JSONDecodeError) as exc:
    raise SystemExit("CasePath isolated runtime probe is invalid") from exc
if not isinstance(probe, dict):
    raise SystemExit("CasePath isolated runtime probe is invalid")
python_real = python_stated.resolve()
base_prefix = Path(probe.get("base_prefix", "")).resolve()
version_tag = f"python{sys.version_info.major}.{sys.version_info.minor}"
site_packages = venv / "lib" / version_tag / "site-packages"
expected_probe_paths = [
    str(base_prefix / "lib" / f"python{sys.version_info.major}{sys.version_info.minor}.zip"),
    str(base_prefix / "lib" / version_tag),
    str(base_prefix / "lib" / version_tag / "lib-dynload"),
    str(site_packages),
]
expected_environment_keys = sorted(
    [*probe_environment]
    + (["__CF_USER_TEXT_ENCODING"] if sys.platform == "darwin" else [])
)
if (
    probe.get("argv") != ["-c"]
    or probe.get("executable") != str(python_stated)
    or probe.get("prefix") != str(venv)
    or probe.get("exec_prefix") != str(venv)
    or probe.get("base_prefix") != str(base_prefix)
    or probe.get("base_exec_prefix") != str(base_prefix)
    or probe.get("enable_user_site") is not False
    or probe.get("path") != expected_probe_paths
    or sorted((probe.get("environment") or {}).keys()) != expected_environment_keys
    or any(
        (probe.get("environment") or {}).get(key) != value
        for key, value in probe_environment.items()
    )
    or probe.get("flags")
    != {
        "dont_write_bytecode": True,
        "ignore_environment": True,
        "isolated": True,
        "no_site": False,
        "no_user_site": True,
        "safe_path": True,
    }
    or probe.get("implementation") != "cpython"
    or probe.get("cache_tag") != "cpython-313"
    or probe.get("python_version") != "3.13.9"
    or probe.get("version_info") != [3, 13, 9, "final", 0]
    or not isinstance(probe.get("python_build"), list)
    or len(probe["python_build"]) != 2
    or not all(isinstance(value, str) and value for value in probe["python_build"])
    or not isinstance(probe.get("python_compiler"), str)
    or not probe["python_compiler"]
):
    raise SystemExit("CasePath isolated runtime path or environment is not closed")
for origin in (probe.get("module_origins") or {}).values():
    if not isinstance(origin, str):
        raise SystemExit("CasePath isolated runtime module is unavailable")
    try:
        Path(origin).resolve().relative_to(venv)
    except ValueError as exc:
        raise SystemExit("CasePath isolated runtime module escaped the venv") from exc
isolated_probe = close_section(
    {
        "contract": "casepath.isolated-python-path-environment-probe/1.0.0",
        "command": [str(python_stated), "-I", "-B", "-P", "-c", probe_program],
        "cwd": str(execution_root),
        "expected_environment": probe_environment,
        "observation": probe,
        "stdout_sha256": digest(completed.stdout),
    }
)


capsule = tree_section(execution_root)
capsule_files = [
    row["path"]
    for row in capsule["roster"]
    if row["kind"] == "file"
]
if capsule_files.count("CAPSULE_RECEIPT.json") != 1:
    raise SystemExit("CasePath active capsule receipt roster is invalid")

site_packages_section = tree_section(site_packages)
if any(row["kind"] == "symlink" for row in site_packages_section["roster"]):
    raise SystemExit("CasePath site-packages contains a symlink")
try:
    python_real.relative_to(base_prefix)
except ValueError as exc:
    raise SystemExit("CasePath resolved Python escaped its reported CPython base") from exc

if python_stated.parent.resolve() != python_stated.parent:
    raise SystemExit("CasePath Python entry has a symlinked venv path")
symlink_chain: list[dict[str, object]] = []
visited_links: set[str] = set()
chain_path = python_stated
while chain_path.is_symlink():
    chain_key = str(chain_path)
    if chain_key in visited_links:
        raise SystemExit("CasePath Python entry symlink chain contains a cycle")
    visited_links.add(chain_key)
    symlink_chain.append(entry(chain_path, chain_key))
    target = os.readlink(chain_path)
    chain_path = Path(
        os.path.normpath(
            target if os.path.isabs(target) else os.path.join(chain_path.parent, target)
        )
    )
if not symlink_chain or chain_path.resolve() != python_real:
    raise SystemExit("CasePath Python entry symlink chain is not exact")
python_runtime = close_section(
    {
        "contract": "casepath.python-runtime-identity/1.0.0",
        "stated_path": str(python_stated),
        "symlink_chain": symlink_chain,
        "symlink_chain_sha256": digest(canonical(symlink_chain)),
        "real_path": str(python_real),
        "real_file": entry(python_real, str(python_real)),
        "base_prefix": str(base_prefix),
        "pyvenv_config": entry(venv / "pyvenv.cfg", str(venv / "pyvenv.cfg")),
        "interpreter_argv_flags": ["-I", "-B", "-P"],
        "implementation": probe["implementation"],
        "cache_tag": probe["cache_tag"],
        "python_version": probe["python_version"],
        "version_info": probe["version_info"],
        "python_build": probe["python_build"],
        "python_compiler": probe["python_compiler"],
    }
)


def normalize_distribution(value: str) -> str:
    return re.sub(r"[-_.]+", "-", value).lower()


requirements_raw, _ = read_regular(execution_root / "casepath-api/requirements.lock")
locked_pins: dict[str, str] = {}
for raw_line in requirements_raw.decode("utf-8").splitlines():
    line = raw_line.strip()
    if not line or line.startswith("#"):
        continue
    if line.count("==") != 1:
        raise SystemExit("CasePath requirements lock contains an unpinned row")
    name, version = line.split("==", 1)
    normalized = normalize_distribution(name)
    if normalized in locked_pins or not normalized or not version:
        raise SystemExit("CasePath requirements lock contains an invalid package row")
    locked_pins[normalized] = version

direct_dist_info = sorted(site_packages.glob("*.dist-info"))
captured_dist_info = sorted(
    row["path"]
    for row in site_packages_section["roster"]
    if row["kind"] == "directory" and row["path"].endswith(".dist-info")
)
if captured_dist_info != [candidate.name for candidate in direct_dist_info]:
    raise SystemExit("CasePath venv contains a noncanonical dist-info instance")
instances: list[dict[str, object]] = []
ownership: dict[str, str] = {}
normalized_instances: set[str] = set()
site_prefix = site_packages.relative_to(venv).as_posix()
site_file_rows = {
    posixpath.join(site_prefix, row["path"]): row
    for row in site_packages_section["roster"]
    if row["kind"] == "file"
}
for dist_info in direct_dist_info:
    metadata_raw, _ = read_regular(dist_info / "METADATA")
    record_raw, _ = read_regular(dist_info / "RECORD")
    message = BytesParser(policy=policy.default).parsebytes(metadata_raw)
    name = message.get("Name")
    version = message.get("Version")
    if not isinstance(name, str) or not isinstance(version, str):
        raise SystemExit("CasePath dist-info metadata lacks a name or version")
    normalized_name = normalize_distribution(name)
    if normalized_name in normalized_instances:
        raise SystemExit("CasePath venv contains duplicate normalized distributions")
    normalized_instances.add(normalized_name)
    if locked_pins.get(normalized_name) != version:
        raise SystemExit("CasePath dist-info instance differs from requirements.lock")
    record_rows: list[dict[str, object]] = []
    record_paths: set[str] = set()
    record_relative = (dist_info / "RECORD").relative_to(venv).as_posix()
    try:
        decoded_record = record_raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise SystemExit("CasePath dist-info RECORD is not UTF-8") from exc
    for csv_row in csv.reader(decoded_record.splitlines()):
        if len(csv_row) != 3:
            raise SystemExit("CasePath dist-info RECORD row is malformed")
        relative, hash_field, size_field = csv_row
        if not relative or "\\" in relative or PurePosixPath(relative).is_absolute():
            raise SystemExit("CasePath dist-info RECORD path is invalid")
        normalized_path = posixpath.normpath(
            posixpath.join(site_packages.relative_to(venv).as_posix(), relative)
        )
        if normalized_path == ".." or normalized_path.startswith("../"):
            raise SystemExit("CasePath dist-info RECORD path escapes the venv")
        if normalized_path in record_paths or normalized_path in ownership:
            raise SystemExit("CasePath dist-info RECORD ownership is duplicated")
        record_paths.add(normalized_path)
        target = venv / normalized_path
        captured_target = site_file_rows.get(normalized_path)
        if captured_target is None:
            if target.is_symlink() or not target.is_file():
                raise SystemExit("CasePath dist-info RECORD target is not regular")
            target_raw, _ = read_regular(target)
            target_sha256 = digest(target_raw)
            target_size = len(target_raw)
        else:
            target_raw = None
            target_sha256 = str(captured_target["sha256"])
            target_size = int(captured_target["size_bytes"])
        if normalized_path == record_relative:
            if hash_field or size_field:
                raise SystemExit("CasePath dist-info RECORD self-row is not canonical")
        else:
            if not hash_field.startswith("sha256=") or not size_field.isdecimal():
                raise SystemExit("CasePath dist-info RECORD row lacks SHA-256 authority")
            expected_hash = base64.urlsafe_b64encode(
                bytes.fromhex(target_sha256)
            ).rstrip(b"=").decode("ascii")
            if hash_field != f"sha256={expected_hash}" or int(size_field) != target_size:
                raise SystemExit("CasePath dist-info RECORD target differs from authority")
        ownership[normalized_path] = dist_info.name
        record_rows.append(
            {
                "hash": hash_field,
                "path": normalized_path,
                "size": size_field,
            }
        )
    record_rows.sort(key=lambda row: row["path"])
    instances.append(
        {
            "dist_info": dist_info.relative_to(site_packages).as_posix(),
            "metadata_sha256": digest(metadata_raw),
            "name": name,
            "normalized_name": normalized_name,
            "record_entry_count": len(record_rows),
            "record_roster_sha256": digest(canonical(record_rows)),
            "record_sha256": digest(record_raw),
            "version": version,
        }
    )
instances.sort(key=lambda row: (row["normalized_name"], row["version"], row["dist_info"]))
if len(instances) != len(locked_pins) or [
    row["normalized_name"] for row in instances
] != sorted(locked_pins):
    raise SystemExit("CasePath dist-info instances are not exact")

site_regular_paths = {
    posixpath.join(site_prefix, row["path"])
    for row in site_packages_section["roster"]
    if row["kind"] == "file"
}
bootstrap_unowned = {
    f"lib/{version_tag}/site-packages/_virtualenv.pth",
    f"lib/{version_tag}/site-packages/_virtualenv.py",
}
unowned = sorted(site_regular_paths - set(ownership))
unowned_bytecode = sorted(
    relative
    for relative in unowned
    if "/__pycache__/" in f"/{relative}" and relative.endswith(".pyc")
)
for relative in unowned_bytecode:
    pure = PurePosixPath(relative)
    cache_index = pure.parts.index("__pycache__")
    filename = pure.name
    match = re.fullmatch(
        r"(.+)\.cpython-313(?:(?:\.opt-[12])|(?:-pytest-[0-9]+\.[0-9]+\.[0-9]+))?\.pyc",
        filename,
    )
    if match is None:
        raise SystemExit("CasePath venv contains noncanonical unowned bytecode")
    source = PurePosixPath(*pure.parts[:cache_index], f"{match.group(1)}.py").as_posix()
    if source not in ownership and source != f"{site_prefix}/_virtualenv.py":
        raise SystemExit("CasePath venv contains unowned bytecode without source authority")
if set(unowned) != bootstrap_unowned | set(unowned_bytecode):
    raise SystemExit("CasePath venv contains an unowned non-bootstrap file")
pth_path = site_packages / "_virtualenv.pth"
pth_raw, pth_metadata = read_regular(pth_path)
if pth_raw != b"import _virtualenv":
    raise SystemExit("CasePath _virtualenv.pth is not exact")
all_entries = site_packages_section["roster"]
injection_paths = []
for row in all_entries:
    relative = str(row["path"])
    lowered = relative.lower()
    basename = PurePosixPath(relative).name.lower()
    parts = PurePosixPath(lowered).parts
    if (
        lowered.endswith(".egg-link")
        or any(part.endswith(".egg") for part in parts)
        or ".egg-info/" in lowered
        or lowered.endswith(".egg-info")
        or basename.startswith("__editable__")
        or basename == "direct_url.json"
        or basename == "easy-install.pth"
        or (lowered.endswith(".pth") and relative != "_virtualenv.pth")
        or any(part in {".git", ".hg", ".svn"} for part in parts)
        or any(
            part in {"sitecustomize", "usercustomize"}
            or part.startswith("sitecustomize.")
            or part.startswith("usercustomize.")
            for part in parts
        )
        or "casepath-eval" in lowered
        or "casepath_eval" in lowered
    ):
        injection_paths.append(relative)
if injection_paths:
    raise SystemExit("CasePath venv contains an injection or editable-install artifact")
ownership_rows = [
    {"dist_info": owner, "path": relative}
    for relative, owner in sorted(ownership.items())
]
distributions = sorted(
    [f"{row['name']}=={row['version']}" for row in instances],
    key=lambda value: (value.casefold(), value),
)
distribution_integrity = close_section(
    {
        "contract": "casepath.python-distribution-record-closure/1.0.0",
        "site_packages": str(site_packages),
        "locked_pins": [
            {"name": name, "version": version}
            for name, version in sorted(locked_pins.items())
        ],
        "dist_info_instance_count": len(instances),
        "dist_info_instances": instances,
        "dist_info_instances_sha256": digest(canonical(instances)),
        "record_owned_path_count": len(ownership_rows),
        "record_ownership": ownership_rows,
        "record_ownership_sha256": digest(canonical(ownership_rows)),
        "allowed_unowned_bytecode_count": len(unowned_bytecode),
        "allowed_unowned_bytecode_sha256": digest(canonical(unowned_bytecode)),
        "bootstrap_unowned_paths": sorted(bootstrap_unowned),
        "bootstrap_unowned_paths_sha256": digest(canonical(sorted(bootstrap_unowned))),
        "virtualenv_pth": {
            "path": pth_path.relative_to(venv).as_posix(),
            "mode": stat.S_IMODE(pth_metadata.st_mode),
            "uid": pth_metadata.st_uid,
            "gid": pth_metadata.st_gid,
            "sha256": digest(pth_raw),
            "size_bytes": len(pth_raw),
            "exact_utf8": "import _virtualenv",
        },
        "installed_distributions": distributions,
        "installed_distributions_sha256": digest(canonical(distributions)),
        "provenance_boundary": (
            "installed_bytes_and_dist_info_RECORD_sha256_only;"
            "original_wheel_archive_hashes_not_captured"
        ),
    }
)

if not isinstance(source_commit, str) or re.fullmatch(r"[0-9a-f]{40}", source_commit) is None:
    raise SystemExit("CasePath runtime source commit is invalid")
data_root = repository / ".runtime/casepath-data-v1"
child_environment = {
    "HOME": str(runtime / "home"),
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "PATH": ":".join(
        (str(venv / "bin"), "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin")
    ),
    "PYTHONHASHSEED": "0",
    "PYTHONNOUSERSITE": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONPYCACHEPREFIX": str(runtime / "pycache"),
    "PYTHONSAFEPATH": "1",
    "SOURCE_DATE_EPOCH": "1786406400",
    "TMPDIR": str(runtime / "tmp"),
    "TZ": "UTC",
    "CASEPATH_MODEL_MODE": "deterministic_reference",
    "CASEPATH_SOURCE_COMMIT": source_commit,
    "CASEPATH_DB_PATH": str(data_root / "casepath.db"),
    "CASEPATH_ARTIFACT_REGISTRY_PATH": str(data_root / "artifact-registry"),
    "CASEPATH_LOCAL_STATIC_ROOT": str(execution_root / "casepath-public"),
    "CASEPATH_LOCAL_RUNTIME_RECEIPT": str(runtime / "runtime-boot-receipt.json"),
    "LANGSMITH_TRACING": "false",
    "LANGCHAIN_TRACING": "false",
    "LANGCHAIN_TRACING_V2": "false",
}
service_argv = [
    str(python_stated), "-I", "-B", "-P", "-m", "uvicorn", "casepath_api.app:app",
    "--app-dir", str(execution_root / "casepath-api"),
    "--host", "127.0.0.1", "--port", "4173", "--no-access-log",
]
permutation_bootstrap = (
    'import runpy,sys; sys.path.insert(0,sys.argv.pop(1)); '
    'runpy.run_path(sys.argv.pop(1),run_name="__main__")'
)
permutation_environment = {
    "HOME": str(runtime / "home"),
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "PATH": ":".join((str(venv / "bin"), "/usr/bin", "/bin", "/usr/sbin", "/sbin")),
    "PYTHONHASHSEED": "0",
    "PYTHONNOUSERSITE": "1",
    "PYTHONSAFEPATH": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "TZ": "UTC",
}
permutation_helper = execution_root / "casepath-qa/production-projection-permutation-v1.py"
launch_context = close_section(
    {
        "contract": "casepath.closed-launch-context/1.0.0",
        "service": {
            "argv": service_argv,
            "cwd": str(repository),
            "app_dir": str(execution_root / "casepath-api"),
            "environment": child_environment,
            "environment_sha256": digest(canonical(child_environment)),
        },
        "permutation_subprocess": {
            "argv": [
                str(python_stated), "-B", "-I", "-P", "-c", permutation_bootstrap,
                str(execution_root / "casepath-api"), str(permutation_helper),
            ],
            "cwd": str(repository),
            "environment": permutation_environment,
            "environment_sha256": digest(canonical(permutation_environment)),
            "helper": entry(permutation_helper, str(permutation_helper)),
        },
    }
)

sections = {
    "capsule": capsule,
    "distribution_integrity": distribution_integrity,
    "isolated_probe": isolated_probe,
    "launch_context": launch_context,
    "python_runtime": python_runtime,
    "site_packages": site_packages_section,
}
subordinate = {
    name: section["closure_sha256"] for name, section in sorted(sections.items())
}
material = {
    "contract": "casepath.executable-runtime-closure/1.1.0",
    "claim_boundary": (
        "exact_active_capsule_python_entry_real_executable_isolated_path_environment_"
        "and_complete_site_packages;cpython_stdlib_tree_and_original_wheel_archives_"
        "not_captured"
    ),
    "sections": sections,
    "subordinate_closure_sha256": subordinate,
}
closure = {**material, "closure_sha256": digest(canonical(material))}
encoded = json.dumps(
    closure,
    ensure_ascii=False,
    allow_nan=False,
    sort_keys=True,
    separators=(",", ":"),
).encode("utf-8") + b"\n"
descriptor = os.open(
    output_path,
    os.O_WRONLY | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0),
)
try:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
        raise SystemExit("CasePath runtime closure output is not regular")
    remaining = memoryview(encoded)
    while remaining:
        written = os.write(descriptor, remaining)
        if written <= 0:
            raise SystemExit("CasePath runtime closure output made no progress")
        remaining = remaining[written:]
    os.fsync(descriptor)
finally:
    os.close(descriptor)
PY
}

run_repository_script() {
  local script="$1"
  shift
  run_clean_locked_python -c \
    'import runpy,sys; from pathlib import Path; script=sys.argv.pop(1); sys.path.insert(0,str(Path(script).resolve().parent)); sys.argv[0]=script; runpy.run_path(script,run_name="__main__")' \
    "$script" "$@"
}

resolve_source_identity() {
  local supplied_commit="${CASEPATH_SOURCE_COMMIT:-}"
  local git_top_level=""
  CASEPATH_SOURCE_COMMIT=""
  CASEPATH_SOURCE_BRANCH="source-archive"
  if command -v git >/dev/null 2>&1; then
    git_top_level="$(git -C "$repository_root" rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$git_top_level" \
      && "$(cd -- "$git_top_level" 2>/dev/null && pwd -P)" == "$repository_root" ]]; then
      CASEPATH_SOURCE_COMMIT="$(git -C "$repository_root" rev-parse --verify HEAD 2>/dev/null || true)"
      CASEPATH_SOURCE_BRANCH="$(git -C "$repository_root" branch --show-current 2>/dev/null || true)"
    fi
  fi
  if [[ ! "$CASEPATH_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ ]]; then
    if [[ ! "$supplied_commit" =~ ^[0-9a-f]{40}$ ]]; then
      printf 'CasePath command failed: source archive requires CASEPATH_SOURCE_COMMIT\n' >&2
      exit 2
    fi
    CASEPATH_SOURCE_COMMIT="$supplied_commit"
    CASEPATH_SOURCE_BRANCH="source-archive"
  elif [[ -z "$CASEPATH_SOURCE_BRANCH" ]]; then
    CASEPATH_SOURCE_BRANCH="detached-head"
  fi
  export CASEPATH_SOURCE_COMMIT CASEPATH_SOURCE_BRANCH
}

build_local_static_output() {
  run_repository_script \
    "$repository_root/casepath/tools/build_static_site.py" \
    --require-known-commit >/dev/null
