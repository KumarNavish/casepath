assert_origin_idle() {
  run_clean_stdlib_python - "$port" <<'PY'
import socket
import sys
import time

port = int(sys.argv[1])
for _ in range(40):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.settimeout(0.25)
        if probe.connect_ex(("127.0.0.1", port)) != 0:
            break
    time.sleep(0.25)
else:
    raise SystemExit(
        f"CasePath launch failed: 127.0.0.1:{port} has a live listener"
    )
PY
}

bootstrap_data_root() {
  local controller_root="$1"
  local expected_manifest_sha256="$2"
  env -i \
    HOME="$runtime_root/home" \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH="$venv_root/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    PYTHONHASHSEED=0 \
    PYTHONNOUSERSITE=1 \
    PYTHONSAFEPATH=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPYCACHEPREFIX="$runtime_root/pycache" \
    TZ=UTC \
    CASEPATH_DATA_ROOT_FAULT_POINT="${CASEPATH_DATA_ROOT_FAULT_POINT:-}" \
    "$python_command" -I -S -B -P - "$controller_root" "$legacy_data_root" \
      "$data_root" "$expected_manifest_sha256" <<'PY'
import hashlib
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
import types

repository = Path(sys.argv[1]).resolve()
manifest_path = repository / "casepath/source-manifest.json"
module_path = repository / "casepath-api/casepath_api/local_data_root.py"
expected_manifest_sha256 = sys.argv[4]


def read_regular_nofollow(path: Path) -> bytes:
    descriptor = os.open(
        path,
        os.O_RDONLY
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0),
    )
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise SystemExit("CasePath durable-data controller is not regular")
        chunks = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                return b"".join(chunks)
            chunks.append(chunk)
    finally:
        os.close(descriptor)


try:
    manifest_raw = read_regular_nofollow(manifest_path)
    manifest = json.loads(manifest_raw)
except (UnicodeDecodeError, json.JSONDecodeError, OSError) as exc:
    raise SystemExit("CasePath durable-data source authority is invalid") from exc
if hashlib.sha256(manifest_raw).hexdigest() != expected_manifest_sha256:
    raise SystemExit("CasePath durable-data source authority changed after preflight")
rows = manifest.get("files") if isinstance(manifest, dict) else None
if not isinstance(rows, list):
    raise SystemExit("CasePath durable-data source authority is invalid")
matches = [
    row
    for row in rows
    if isinstance(row, dict)
    and row.get("path") == "casepath-api/casepath_api/local_data_root.py"
]
try:
    module_raw = read_regular_nofollow(module_path)
except OSError as exc:
    raise SystemExit("CasePath durable-data controller is unavailable") from exc
if len(matches) != 1 or matches[0] != {
    "executable": False,
    "path": "casepath-api/casepath_api/local_data_root.py",
    "sha256": hashlib.sha256(module_raw).hexdigest(),
    "size_bytes": len(module_raw),
}:
    raise SystemExit("CasePath durable-data controller differs from sealed source")
module = types.ModuleType("casepath_sealed_local_data_root")
module.__file__ = str(module_path)
module.__package__ = ""
sys.modules[module.__name__] = module
try:
    exec(compile(module_raw, str(module_path), "exec"), module.__dict__)
except Exception as exc:
    raise SystemExit("CasePath durable-data controller cannot be loaded") from exc
controller = getattr(module, "bootstrap_data_root", None)
if not callable(controller):
    raise SystemExit("CasePath durable-data controller is incomplete")


def validate_staged_database(database_path: Path) -> None:
    validator_environment = {
        key: os.environ[key]
        for key in (
            "HOME",
            "LANG",
            "LC_ALL",
            "PATH",
            "PYTHONHASHSEED",
            "PYTHONNOUSERSITE",
            "PYTHONSAFEPATH",
            "PYTHONDONTWRITEBYTECODE",
            "PYTHONPYCACHEPREFIX",
            "TZ",
        )
    }
    completed = subprocess.run(
        [
            sys.executable,
            "-I",
            "-B",
            "-P",
            "-c",
            (
                "import runpy,sys;sys.path.insert(0,sys.argv.pop(1));"
                "sys.argv[0]='validate_journal';"
                "runpy.run_module('casepath_api.validate_journal',"
                "run_name='__main__',alter_sys=True)"
            ),
            str(repository / "casepath-api"),
            str(database_path),
        ],
        cwd=repository,
        env=validator_environment,
        check=False,
        capture_output=True,
        timeout=180,
    )
    if completed.returncode != 0:
        raise SystemExit("CasePath staged durable journal is invalid")
    try:
        validator_receipt = json.loads(completed.stdout)
        validator_material = dict(validator_receipt)
        validator_stated = validator_material.pop("receipt_sha256")
    except (UnicodeDecodeError, json.JSONDecodeError, KeyError, TypeError) as exc:
        raise SystemExit(
            "CasePath staged durable journal receipt is invalid"
        ) from exc
    validator_encoded = json.dumps(
        validator_material,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode()
    if (
        validator_receipt.get("contract")
        != "casepath.read-only-journal-validation/1.0.0"
        or validator_receipt.get("database_path")
        != str(database_path.resolve())
        or validator_stated != hashlib.sha256(validator_encoded).hexdigest()
    ):
        raise SystemExit("CasePath staged durable journal receipt is invalid")


fault = os.environ.get("CASEPATH_DATA_ROOT_FAULT_POINT") or None
receipt = controller(
    sys.argv[2],
    sys.argv[3],
    fault_point=fault,
    staged_database_validator=validate_staged_database,
)
print(json.dumps(receipt, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
PY
}

validate_durable_journal() {
  local sealed_root="$1"
  local database_path="${2:-$data_root/casepath.db}"
  /usr/bin/env -i \
    HOME="$runtime_root/home" \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH="$venv_root/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    PYTHONHASHSEED=0 \
    PYTHONNOUSERSITE=1 \
    PYTHONSAFEPATH=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPYCACHEPREFIX="$runtime_root/pycache" \
    SOURCE_DATE_EPOCH=1786406400 \
    TMPDIR="$runtime_root/tmp" \
    TZ=UTC \
    "$python_command" -I -B -P -c \
    'import runpy,sys; sys.path.insert(0,sys.argv.pop(1)); sys.argv[0]="validate_journal"; runpy.run_module("casepath_api.validate_journal",run_name="__main__",alter_sys=True)' \
    "$sealed_root/casepath-api" "$database_path"
}

# Provider and tracing credentials are outside the local product capability.
# Remove their names before importing any CasePath module or build verifier.
unset OPENROUTER_API_KEY LANGSMITH_API_KEY LANGCHAIN_API_KEY \
  LANGSMITH_TRACING LANGCHAIN_TRACING LANGCHAIN_TRACING_V2 \
  RENDER_GIT_COMMIT

usage() {
  cat <<'EOF'
Usage:
  ./bin/casepath dev
  ./bin/casepath prepare
  ./bin/casepath seed --corpus synthetic-150
  ./bin/casepath test
  ./bin/casepath replay <claim-id>
  ./bin/casepath adapter-check examples/local_source_adapter.py

Starts the deterministic CasePath product on one persistent localhost origin.
The command owns its locked Python environment, sealed-static verification, SQLite journal,
artifact registry, readiness gate, and child process. Press Ctrl-C to stop it.
EOF
}

operation="${1:-}"
if [[ "$operation" == "dev" && "$#" -ne 1 ]]; then
  usage >&2
  exit 2
fi
if [[ "$operation" != "dev" && "$operation" != "prepare" && "$operation" != "seed" && "$operation" != "test" && "$operation" != "replay" && "$operation" != "adapter-check" ]]; then
  usage >&2
  exit 2
fi

ensure_private_runtime_root

if [[ -z "$uv_command" ]]; then
  uv_command="$(command -v uv || true)"
fi
if [[ -z "$uv_command" || ! -x "$uv_command" ]]; then
  printf 'CasePath launch failed: install uv or set CASEPATH_UV to its executable path\n' >&2
  exit 2
fi

# Every command shares one pinned environment.  Hold a kernel lease for the
# complete command lifetime so no sibling command can run `uv pip sync` while
# the server or test interpreter is using that environment.  The test command
# deliberately invokes this launcher from inside pytest; that child may reuse
# the environment only when the same exact lockf/flock owner remains a live
# ancestor and the outer launcher has already completed dependency sync.
environment_lock_path="$runtime_root/environment.lock"
lock_owner_operating_system="$(/usr/bin/uname -s)"
case "$lock_owner_operating_system" in
  Darwin)
    trusted_lock_executable="/usr/bin/lockf"
    trusted_lock_name="lockf"
    ;;
  Linux)
    trusted_lock_executable="/usr/bin/flock"
    trusted_lock_name="flock"
    ;;
  *)
    printf 'CasePath command failed: unsupported kernel-lock platform\n' >&2
    exit 2
    ;;
esac
if [[ ! -x "$trusted_lock_executable" ]]; then
  printf 'CasePath command failed: trusted kernel-lock executable is unavailable\n' >&2
  exit 2
fi
process_is_trusted_lock_owner() {
  local process_id="$1"
  case "$lock_owner_operating_system" in
    Darwin)
      /usr/sbin/lsof -n -a -p "$process_id" -d txt -Fn 2>/dev/null \
        | /usr/bin/grep -Fx "n$trusted_lock_executable" >/dev/null
      ;;
    Linux)
      [[ "$(/usr/bin/readlink -f "/proc/$process_id/exe" 2>/dev/null || true)" \
        == "$(/usr/bin/readlink -f "$trusted_lock_executable")" ]]
      ;;
  esac
}
process_holds_exact_lock_file() {
  local process_id="$1"
  local lock_path="$2"
  local operating_system=""
  local target_identity=""
  local descriptor=""
  operating_system="$lock_owner_operating_system"
  case "$operating_system" in
    Darwin)
      if [[ ! -x /usr/sbin/lsof ]]; then
        return 1
      fi
      /usr/sbin/lsof -n -a -p "$process_id" -Fn -- "$lock_path" 2>/dev/null \
        | /usr/bin/grep -Fx "n$lock_path" >/dev/null
      ;;
    Linux)
      if [[ ! -d "/proc/$process_id/fd" ]]; then
        return 1
      fi
      target_identity="$(/usr/bin/stat -Lc '%d:%i' "$lock_path" 2>/dev/null || true)"
      if [[ -z "$target_identity" ]]; then
        return 1
      fi
      for descriptor in "/proc/$process_id/fd/"*; do
        if [[ "$(/usr/bin/stat -Lc '%d:%i' "$descriptor" 2>/dev/null || true)" == "$target_identity" ]]; then
          return 0
        fi
      done
      return 1
      ;;
    *)
      return 1
      ;;
  esac
}
has_exact_lock_owner_ancestor() {
  local lock_path="$1"
  local ancestor="$PPID"
  local ancestor_name=""
  local next_ancestor=""
  while [[ "$ancestor" =~ ^[0-9]+$ ]] && (( ancestor > 1 )); do
    ancestor_name="$(/bin/ps -p "$ancestor" -o comm= 2>/dev/null || true)"
    ancestor_name="${ancestor_name##*/}"
    if [[ "$ancestor_name" == "$trusted_lock_name" ]] \
      && process_is_trusted_lock_owner "$ancestor" \
      && process_holds_exact_lock_file "$ancestor" "$lock_path"; then
      return 0
    fi
    next_ancestor="$(/bin/ps -p "$ancestor" -o ppid= 2>/dev/null | /usr/bin/tr -d '[:space:]')"
    if [[ -z "$next_ancestor" || "$next_ancestor" == "$ancestor" ]]; then
      break
    fi
    ancestor="$next_ancestor"
  done
  return 1
}
if [[ "${CASEPATH_ENV_LOCK_HELD:-}" == "1" ]]; then
  if ! has_exact_lock_owner_ancestor "$environment_lock_path"; then
    printf 'CasePath command failed: environment lease marker has no exact kernel lock owner\n' >&2
    exit 2
  fi
else
  if [[ "$lock_owner_operating_system" == "Darwin" ]]; then
    exec "$trusted_lock_executable" -k -t 0 "$environment_lock_path" \
      /usr/bin/env CASEPATH_ENV_LOCK_HELD=1 CASEPATH_ENV_READY=0 \
      CASEPATH_INVOCATION_DIRECTORY="$invocation_directory" "$0" "$@"
  else
    exec "$trusted_lock_executable" -n "$environment_lock_path" \
      /usr/bin/env CASEPATH_ENV_LOCK_HELD=1 CASEPATH_ENV_READY=0 \
      CASEPATH_INVOCATION_DIRECTORY="$invocation_directory" "$0" "$@"
  fi
fi

# Seed, replay, and the serving process share one durable-data election. This
# covers first-copy publication, schema migration, and all later journal use;
# two launchers can never race a partially published data root.
if [[ "$operation" == "dev" || "$operation" == "seed" || "$operation" == "replay" ]]; then
  mkdir -p "$repository_root/.runtime"
  if [[ "${CASEPATH_DATA_LOCK_HELD:-}" != "1" ]]; then
    if [[ "$lock_owner_operating_system" == "Darwin" ]]; then
      exec "$trusted_lock_executable" -k -t 0 "$repository_root/.runtime/casepath-data-v1.lock" \
        /usr/bin/env CASEPATH_DATA_LOCK_HELD=1 "$0" "$@"
    else
      exec "$trusted_lock_executable" -n "$repository_root/.runtime/casepath-data-v1.lock" \
        /usr/bin/env CASEPATH_DATA_LOCK_HELD=1 "$0" "$@"
    fi
  fi
  # Public environment markers are never lock authority. Require an exact
  # open-file identity in a live lockf/flock ancestor, including nested dev
  # re-entry after the launch lock is acquired.
  if [[ "${CASEPATH_DATA_LOCK_HELD:-}" == "1" ]] \
    && ! has_exact_lock_owner_ancestor "$repository_root/.runtime/casepath-data-v1.lock"; then
    printf 'CasePath command failed: data lease marker has no exact kernel lock owner\n' >&2
    exit 2
  fi
fi

# Non-serving commands use the same pinned interpreter, dependency lock, local
# database, closed credential environment, and product modules as `dev`.
if [[ "$operation" != "dev" ]]; then
  cli_arguments=("$@")
  if [[ "$operation" == "adapter-check" && "${2:-}" != /* ]]; then
    cli_arguments=("adapter-check" "$invocation_directory/${2:-}")
  fi
  ensure_private_runtime_directories
  if [[ "${CASEPATH_ENV_READY:-}" != "1" && ! -x "$python_command" ]]; then
    "$uv_command" venv --python 3.13.9 "$venv_root"
  fi
  if [[ "$(run_clean_stdlib_python -c 'import platform; print(platform.python_version())')" != "3.13.9" ]]; then
    printf 'CasePath command failed: runtime Python must be 3.13.9\n' >&2
    exit 2
  fi
  if [[ "$operation" == "prepare" ]]; then
    source_only_manifest_sha256="$(verify_sealed_source_tree source-only)"
  else
    preflight_source_manifest_sha256="$(verify_sealed_source_tree)"
  fi
  if [[ "${CASEPATH_ENV_READY:-}" != "1" ]]; then
    "$uv_command" pip sync --python "$python_command" "$repository_root/casepath-api/requirements.lock" >/dev/null
    export CASEPATH_ENV_READY=1
  fi
  resolve_source_identity
  if [[ "$operation" == "prepare" ]]; then
    prepare_generated_outputs
    preflight_source_manifest_sha256="$(verify_sealed_source_tree)"
    if [[ "$preflight_source_manifest_sha256" != "$source_only_manifest_sha256" ]]; then
      printf 'CasePath command failed: source manifest drifted during preparation\n' >&2
      exit 2
    fi
  elif [[ "$operation" != "adapter-check" ]]; then
    build_local_static_output
  fi
  if [[ "$operation" == "prepare" ]]; then
    # Materialize and verify the exact read-only source capsule without
    # opening durable product data or requiring the live origin to stop.
    # This is the safe pre-cutover producer consumed by the append-only
    # publisher; it has no CLI/domain side effect.
    execution_root="$(
      materialize_sealed_source_capsule "$preflight_source_manifest_sha256"
    )"
    verify_release_capsule "$execution_root"
    printf '%s\n' "$execution_root"
    exit 0
  fi
  if [[ "$operation" == "seed" || "$operation" == "replay" ]]; then
    assert_origin_idle
    execution_root="$(
      materialize_sealed_source_capsule "$preflight_source_manifest_sha256"
    )"
    verify_release_capsule "$execution_root"
    if [[ -e "$data_root/casepath.db" || -L "$data_root/casepath.db" ]]; then
      # Existing durable bytes must be semantically valid before the history
      # reconciler is allowed to promote any prepared receipt or pointer.
      validate_durable_journal "$execution_root" >/dev/null
    elif [[ -e "$legacy_data_root/casepath.db" || -L "$legacy_data_root/casepath.db" ]]; then
      # A first migration must never publish a reducer-invalid legacy journal.
      # Validate the exact migration source before any durable successor exists.
      validate_durable_journal \
        "$execution_root" "$legacy_data_root/casepath.db" >/dev/null
    fi
    run_clean_stdlib_python \
      "$execution_root/casepath/tools/validate_local_runtime_history.py" \
      "$runtime_root" "$data_root" "$repository_root"
    bootstrap_data_root "$execution_root" "$preflight_source_manifest_sha256"
    validate_durable_journal "$execution_root" >/dev/null
  else
    execution_root="$repository_root"
  fi
  if [[ "$operation" == "seed" || "$operation" == "replay" ]]; then
    command_database="$data_root/casepath.db"
    command_registry="$data_root/artifact-registry"
  else
    command_database="$runtime_root/tmp/${operation}-outer-$$.db"
    command_registry="$runtime_root/tmp/${operation}-outer-artifacts-$$"
  fi
  cd "$repository_root"
  exec /usr/bin/env -i \
    HOME="$runtime_root/home" \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH="$venv_root/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    PYTHONHASHSEED=0 \
    PYTHONNOUSERSITE=1 \
    PYTHONSAFEPATH=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPYCACHEPREFIX="$runtime_root/pycache" \
    SOURCE_DATE_EPOCH=1786406400 \
    TMPDIR="$runtime_root/tmp" \
    TZ=UTC \
    CASEPATH_MODEL_MODE=deterministic_reference \
    CASEPATH_SOURCE_COMMIT="$CASEPATH_SOURCE_COMMIT" \
    CASEPATH_DB_PATH="$command_database" \
    CASEPATH_ARTIFACT_REGISTRY_PATH="$command_registry" \
    CASEPATH_ENV_LOCK_HELD=1 \
    CASEPATH_ENV_READY=1 \
    CASEPATH_UV_RESOLVED="$uv_command" \
    "$python_command" -I -B -P -c \
    'import runpy,sys; sys.path.insert(0,sys.argv.pop(1)); sys.argv[0]="casepath"; runpy.run_module("casepath_api.cli",run_name="__main__",alter_sys=True)' \
    "$execution_root/casepath-api" "${cli_arguments[@]}"
fi

ensure_private_runtime_root

# Hold one kernel-backed launch lease across build, serve, and shutdown. This
# closes the check-then-bind race between two simultaneous `casepath dev`
# invocations; the fixed-port probe below remains a separate foreign-listener
# guard. lockf releases the lease on every process exit, including crashes.
if [[ "${CASEPATH_LAUNCH_LOCK_HELD:-}" != "1" ]]; then
  if [[ "$lock_owner_operating_system" == "Darwin" ]]; then
    exec "$trusted_lock_executable" -k -t 0 "$runtime_root/launcher.lock" \
      /usr/bin/env CASEPATH_LAUNCH_LOCK_HELD=1 "$0" "$@"
  else
    exec "$trusted_lock_executable" -n "$runtime_root/launcher.lock" \
      /usr/bin/env CASEPATH_LAUNCH_LOCK_HELD=1 "$0" "$@"
  fi
fi
if ! has_exact_lock_owner_ancestor "$runtime_root/launcher.lock"; then
  printf 'CasePath launch failed: runtime lease marker has no kernel lock owner\n' >&2
  exit 2
fi

ensure_private_runtime_directories

# The reconciliation controller is deliberately the same pinned interpreter
# that later validates and serves the product. Materialize and verify it before
# the first controller invocation so a genuinely clean checkout has no hidden
# system-Python dependency and cannot fail before `uv venv` has run.
if [[ ! -x "$python_command" ]]; then
  "$uv_command" venv --python 3.13.9 "$venv_root"
fi

actual_python="$(run_clean_stdlib_python -c 'import platform; print(platform.python_version())')"
if [[ "$actual_python" != "3.13.9" ]]; then
  printf 'CasePath launch failed: runtime Python is %s, expected 3.13.9\n' "$actual_python" >&2
  exit 2
fi

# Publish authority directories durably before any crash-injection boundary can
# publish a boot receipt inside them.  Fsync both each directory and its parent
# so a fresh-machine restart cannot lose an otherwise fsynced history entry.
run_clean_stdlib_python - "$runtime_root" <<'PY'
import os
from pathlib import Path
import sys

runtime = Path(sys.argv[1]).resolve()
for directory in (
    runtime,
    runtime / "boots",
    runtime / "boot-staging",
):
    if directory.is_symlink() or not directory.is_dir():
        raise SystemExit("CasePath runtime authority directory is invalid")
    for target in (directory, directory.parent):
        descriptor = os.open(target, os.O_RDONLY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
PY
preflight_source_manifest_sha256="$(verify_sealed_source_tree)"
resolve_source_identity
build_local_static_output
execution_root="$(
  materialize_sealed_source_capsule "$preflight_source_manifest_sha256"
)"

# Recover a fully published history receipt that survived a crash before the
# mutable current pointer was replaced. History files are immutable, so the
# only lawful recovery is to validate the single append-only chain and advance
# the pointer to its unique tip. Incomplete staging files are never authority.
run_clean_stdlib_python - "$runtime_root" "$data_root" <<'PY'
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import re
import sys
import uuid

runtime = Path(sys.argv[1]).resolve()
data_root = Path(sys.argv[2]).resolve()
boots = runtime / "boots"
current = runtime / "runtime-boot-receipt.json"
boot_name = re.compile(r"boot-[A-Za-z0-9TZ-]+\.json")
sha_pattern = re.compile(r"[0-9a-f]{64}")


def canonical(value: object) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")


def digest(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def validate_receipt(path: Path) -> tuple[bytes, dict[str, object], str]:
    if path.is_symlink() or not path.is_file() or not boot_name.fullmatch(path.name):
        raise SystemExit(f"CasePath boot history contains a noncanonical entry: {path.name}")
    raw = path.read_bytes()
    try:
        value = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SystemExit(f"CasePath boot history is not valid JSON: {path.name}") from exc
    if not isinstance(value, dict):
        raise SystemExit(f"CasePath boot history is not an object: {path.name}")
    semantic = dict(value)
    receipt_sha = semantic.pop("receipt_sha256", None)
    prior = value.get("prior_boot_receipt_file_sha256")
    if (
        value.get("contract")
        not in {
            "casepath.local-runtime-boot/2.0.0",
            "casepath.local-runtime-boot/2.1.0",
            "casepath.local-runtime-boot/2.2.0",
        }
        or value.get("boot_id") != path.stem
        or receipt_sha != digest(canonical(semantic))
        or (prior is not None and (not isinstance(prior, str) or not sha_pattern.fullmatch(prior)))
    ):
        raise SystemExit(f"CasePath boot history receipt is invalid: {path.name}")
    return raw, value, digest(raw)


entries: dict[str, tuple[bytes, dict[str, object], Path]] = {}
for candidate in sorted(boots.iterdir()):
    raw, receipt, file_sha = validate_receipt(candidate)
    if file_sha in entries:
        raise SystemExit(f"CasePath boot history duplicates receipt bytes: {file_sha}")
    entries[file_sha] = (raw, receipt, candidate)

if entries:
    roots = [file_sha for file_sha, (_, value, _) in entries.items() if value.get("prior_boot_receipt_file_sha256") is None]
    if len(roots) != 1:
        raise SystemExit("CasePath boot history does not have exactly one root")
    children: dict[str, list[str]] = {}
    for file_sha, (_, value, _) in entries.items():
        prior = value.get("prior_boot_receipt_file_sha256")
        if prior is not None:
            if prior not in entries:
                raise SystemExit(f"CasePath boot history is missing prior receipt: {prior}")
            children.setdefault(prior, []).append(file_sha)
    chain = [roots[0]]
    while children.get(chain[-1]):
        successors = children[chain[-1]]
        if len(successors) != 1:
            raise SystemExit("CasePath boot history contains a fork")
        chain.append(successors[0])
    if set(chain) != set(entries):
        raise SystemExit("CasePath boot history contains an unreachable receipt")
    current_sha = None
    if current.exists():
        if current.is_symlink() or not current.is_file():
            raise SystemExit("CasePath current boot receipt is not a regular file")
        current_sha = digest(current.read_bytes())
        if current_sha not in entries:
            raise SystemExit("CasePath current boot receipt is outside the history chain")
    tip_sha = chain[-1]
    tip_receipt = entries[tip_sha][1]
    tip_runtime = tip_receipt.get("runtime")
    provenance = data_root / "DATA_ROOT_PROVENANCE.json"
    if (
        not isinstance(tip_runtime, dict)
        or tip_runtime.get("data_root") != str(data_root)
        or tip_runtime.get("database_path") != str(data_root / "casepath.db")
        or tip_runtime.get("artifact_registry_path")
        != str(data_root / "artifact-registry")
        or not isinstance(
            tip_runtime.get("data_root_provenance_file_sha256"), str
        )
        or not sha_pattern.fullmatch(
            tip_runtime["data_root_provenance_file_sha256"]
        )
        or data_root.is_symlink()
        or not data_root.is_dir()
        or provenance.is_symlink()
        or not provenance.is_file()
        or digest(provenance.read_bytes())
        != tip_runtime["data_root_provenance_file_sha256"]
    ):
        raise SystemExit(
            "CasePath durable data root differs from the accepted boot lineage"
        )
    # Pointer promotion is intentionally deferred to the full capsule-bound
    # verifier below.  This structural pass must never make a receipt current.
elif current.exists():
    raise SystemExit("CasePath current boot receipt exists without immutable history")
PY

if [[ "${CASEPATH_ENV_READY:-}" != "1" ]]; then
  "$uv_command" pip sync \
    --python "$python_command" \
    "$repository_root/casepath-api/requirements.lock" >/dev/null
  export CASEPATH_ENV_READY=1
fi

runtime_closure_after_sync_path="$(
  /usr/bin/mktemp "$runtime_root/tmp/runtime-closure-after-sync.XXXXXX"
)"
runtime_closure_before_child_path="$(
  /usr/bin/mktemp "$runtime_root/tmp/runtime-closure-before-child.XXXXXX"
)"
runtime_closure_after_ready_path="$(
  /usr/bin/mktemp "$runtime_root/tmp/runtime-closure-after-ready.XXXXXX"
)"
capture_runtime_closure "$execution_root" "$runtime_closure_after_sync_path"

# When a durable database already exists, replay it through the captured
# production reducer before the history controller may promote a recovered
# receipt. Fresh roots are replayed immediately after bootstrap below.
if [[ -e "$data_root/casepath.db" || -L "$data_root/casepath.db" ]]; then
  validate_durable_journal "$execution_root" >/dev/null
elif [[ -e "$legacy_data_root/casepath.db" || -L "$legacy_data_root/casepath.db" ]]; then
  # The legacy root is a migration input, not a trusted exception. Replay it
  # through the same sealed reducers before bootstrap can publish new bytes.
  validate_durable_journal \
    "$execution_root" "$legacy_data_root/casepath.db" >/dev/null
fi

# The controller itself is captured in the sealed capsule. After semantic
# replay succeeds, it validates every historical receipt against that receipt's
# own capsule and may atomically promote the unique append-only tip.
run_clean_stdlib_python \
  "$execution_root/casepath/tools/validate_local_runtime_history.py" \
  "$runtime_root" "$data_root" "$repository_root"

# Refuse before fixture or static materialization when another process is
# actually accepting connections on the product origin. Do not use an
# exclusive probe bind here: macOS may retain the previous socket in TIME_WAIT
# after a crash-safe shutdown even though no process owns the port. Uvicorn's
# own bind remains the authoritative race-closing operation.
assert_origin_idle

export SOURCE_DATE_EPOCH=1786406400

# Launch is a consumer of a sealed source tree, never a source generator.
# Maintainers explicitly generate artifacts and the source manifest before a
# release; the normal user command only verifies those exact bytes.
run_repository_script "$repository_root/casepath/tools/casepath_release.py" verify >/dev/null
run_repository_script "$execution_root/casepath/tools/casepath_release.py" verify >/dev/null
source_manifest_before_child_sha256="$(
  run_clean_stdlib_python - "$repository_root/casepath/source-manifest.json" <<'PY'
import hashlib
from pathlib import Path
import sys
print(hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest())
PY
)"
if [[ "$source_manifest_before_child_sha256" != "$preflight_source_manifest_sha256" ]]; then
  printf 'CasePath launch failed: source changed after sealed capsule capture\n' >&2
  exit 2
fi
static_inventory_before_child_sha256="$(
  run_clean_locked_python - "$execution_root" "$CASEPATH_SOURCE_COMMIT" <<'PY'
import hashlib
import json
from pathlib import Path
import sys
repository = Path(sys.argv[1])
source_commit = sys.argv[2]
root = repository / "casepath-public"
sys.path.insert(0, str(repository / "casepath/tools"))
from build_static_site import verify_inventory
verify_inventory(root)
rows = [
    {
        "path": path.relative_to(root).as_posix(),
        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        "bytes": path.stat().st_size,
    }
    for path in sorted(root.rglob("*"))
    if path.is_file()
]
for row in rows:
    if row["path"] == "deployment.json":
        continue
    authored = repository / "casepath" / row["path"]
    if not authored.is_file() or authored.is_symlink():
        raise SystemExit(f"built file lacks an authored regular source: {row['path']}")
    authored_bytes = authored.read_bytes()
    if hashlib.sha256(authored_bytes).hexdigest() != row["sha256"] or len(authored_bytes) != row["bytes"]:
        raise SystemExit(f"built file differs from authored source: {row['path']}")
deployment = json.loads((root / "deployment.json").read_text())
release = json.loads((repository / "casepath/release.json").read_text())
if not (
    deployment.get("contract") == "casepath.deployment-identity/1.0.0"
    and deployment.get("alignment_eligible") is True
    and deployment.get("source_commit") == source_commit
    and deployment.get("release_id") == release.get("release_id")
    and deployment.get("component_version") == release.get("components", {}).get("frontend", {}).get("version")
    and deployment.get("component_contract") == release.get("components", {}).get("frontend", {}).get("contract")
):
    raise SystemExit("built deployment identity differs from source/release authority")
encoded = json.dumps(rows, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")).encode()
print(hashlib.sha256(encoded).hexdigest())
PY
)"

# Only a completely verified source/static snapshot may perform the one-time
# durable migration or open the product database.
bootstrap_data_root "$execution_root" "$preflight_source_manifest_sha256"
validate_durable_journal "$execution_root" >/dev/null

# A prior successful boot is a monotonic durability checkpoint. The mutable
# database may legitimately gain events and the immutable registry may gain
# artifacts, but neither may lose or rewrite anything previously attested.
run_clean_stdlib_python - "$runtime_root" "$data_root" <<'PY'
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import sqlite3
import stat
import sys

runtime = Path(sys.argv[1]).resolve()
data_root = Path(sys.argv[2]).resolve()
current = runtime / "runtime-boot-receipt.json"
if not current.exists():
    raise SystemExit(0)
if current.is_symlink() or not current.is_file():
    raise SystemExit("CasePath durability checkpoint is not regular")
try:
    receipt = json.loads(current.read_bytes())
except (UnicodeDecodeError, json.JSONDecodeError) as exc:
    raise SystemExit("CasePath durability checkpoint is invalid") from exc
if receipt.get("contract") == "casepath.local-runtime-boot/2.0.0":
    raise SystemExit(0)
if receipt.get("contract") not in {
    "casepath.local-runtime-boot/2.1.0",
    "casepath.local-runtime-boot/2.2.0",
}:
    raise SystemExit("CasePath durability checkpoint contract is invalid")
attestation = receipt.get("attestation")
if not isinstance(attestation, dict):
    raise SystemExit("CasePath durability checkpoint attestation is invalid")


def canonical(value: object) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")


prior_events = attestation.get("durable_event_roster")
prior_registry = attestation.get("durable_registry_inventory")
if (
    not isinstance(prior_events, list)
    or attestation.get("durable_event_count") != len(prior_events)
    or attestation.get("durable_event_roster_sha256")
    != hashlib.sha256(canonical(prior_events)).hexdigest()
    or not isinstance(prior_registry, list)
    or attestation.get("durable_registry_file_count") != len(prior_registry)
    or attestation.get("durable_registry_inventory_sha256")
    != hashlib.sha256(canonical(prior_registry)).hexdigest()
):
    raise SystemExit("CasePath durability checkpoint roster is invalid")

database = data_root / "casepath.db"
descriptor = os.open(
    database,
    os.O_RDONLY
    | getattr(os, "O_CLOEXEC", 0)
    | getattr(os, "O_NOFOLLOW", 0)
    | getattr(os, "O_NONBLOCK", 0),
)
try:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
        raise SystemExit("CasePath durable database identity is invalid")
finally:
    os.close(descriptor)
with sqlite3.connect(f"file:{database.as_posix()}?mode=ro", uri=True) as connection:
    if connection.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
        raise SystemExit("CasePath durable database failed integrity check")
    current_events = [
        {
            "session_id": row[0],
            "loop_id": row[1],
            "sequence": row[2],
            "event_sha256": row[3],
            "event_json_sha256": hashlib.sha256(row[4].encode("utf-8")).hexdigest(),
        }
        for row in connection.execute(
            """SELECT session_id,loop_id,sequence,event_sha256,event_json
            FROM claim_loop_events
            ORDER BY session_id,loop_id,sequence"""
        )
    ]
current_event_by_key = {
    (row["session_id"], row["loop_id"], row["sequence"]): row
    for row in current_events
}
if any(
    current_event_by_key.get(
        (row.get("session_id"), row.get("loop_id"), row.get("sequence"))
    )
    != row
    for row in prior_events
):
    raise SystemExit("CasePath durable event journal rolled back")

registry = data_root / "artifact-registry"
if registry.is_symlink() or not registry.is_dir():
    raise SystemExit("CasePath durable registry is invalid")
current_registry = []
for path in sorted(registry.rglob("*")):
    metadata = path.lstat()
    if path.is_symlink() or (
        not stat.S_ISREG(metadata.st_mode)
        and not stat.S_ISDIR(metadata.st_mode)
    ):
        raise SystemExit("CasePath durable registry contains an invalid entry")
    if stat.S_ISREG(metadata.st_mode):
        if metadata.st_nlink != 1:
            raise SystemExit("CasePath durable registry contains a linked file")
        raw = path.read_bytes()
        current_registry.append(
            {
                "path": path.relative_to(registry).as_posix(),
                "sha256": hashlib.sha256(raw).hexdigest(),
                "size_bytes": len(raw),
            }
        )
current_registry_by_path = {row["path"]: row for row in current_registry}
if any(
    current_registry_by_path.get(row.get("path")) != row
    for row in prior_registry
):
    raise SystemExit("CasePath durable artifact registry rolled back")
PY

# A first local launch must open a useful product, not an empty shell that asks
# the user to coordinate another command. The exact corpus import is itself
# idempotent, journal-authoritative, outcome-blind, and uses the same database
# and closed environment as the serving process.
IFS=$'\t' read -r bundled_corpus_id bundled_claim_count <<<"$(
  read_bundled_corpus_identity "$execution_root"
)"
seed_receipt="$runtime_root/latest-workspace-seed-receipt.json"
seed_receipt_staging="$runtime_root/.latest-workspace-seed-receipt.$$.tmp"
env -i \
  HOME="$runtime_root/home" \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PATH="$venv_root/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
  PYTHONHASHSEED=0 \
  PYTHONNOUSERSITE=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  PYTHONPYCACHEPREFIX="$runtime_root/pycache" \
  PYTHONSAFEPATH=1 \
  TMPDIR="$runtime_root/tmp" \
  TZ=UTC \
  CASEPATH_DB_PATH="$data_root/casepath.db" \
  CASEPATH_ARTIFACT_REGISTRY_PATH="$data_root/artifact-registry" \
  "$python_command" -I -B -P -c \
  'import runpy,sys; sys.path.insert(0,sys.argv.pop(1)); sys.argv[0]="casepath"; runpy.run_module("casepath_api.cli",run_name="__main__",alter_sys=True)' \
  "$execution_root/casepath-api" seed --corpus "$bundled_corpus_id" \
  >"$seed_receipt_staging"
run_clean_stdlib_python - "$seed_receipt_staging" "$seed_receipt" <<'PY'
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import sys

staging = Path(sys.argv[1])
destination = Path(sys.argv[2])


def canonical(value: object) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")


def digest(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


if staging.is_symlink() or not staging.is_file():
    raise SystemExit("CasePath workspace seed staging receipt is not regular")
raw = staging.read_bytes()
try:
    receipt = json.loads(raw)
except (UnicodeDecodeError, json.JSONDecodeError) as exc:
    raise SystemExit("CasePath workspace seed receipt is invalid") from exc
semantic = dict(receipt) if isinstance(receipt, dict) else {}
stated = semantic.pop("receipt_sha256", None)
if (
    set(receipt) != {"contract", "seed_receipt", "source_authority", "receipt_sha256"}
    or receipt.get("contract") != "casepath.sealed-workspace-seed/1.0.0"
    or stated != digest(canonical(semantic))
):
    raise SystemExit("CasePath workspace seed receipt is invalid")
with staging.open("rb") as stream:
    os.fsync(stream.fileno())
if destination.is_symlink() or (destination.exists() and not destination.is_file()):
    raise SystemExit("CasePath workspace seed receipt destination is invalid")
os.replace(staging, destination)
descriptor = os.open(destination.parent, os.O_RDONLY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
PY

shutdown() {
  local signal="${1:-TERM}"
  if [[ -n "$child_pid" ]] && kill -0 "$child_pid" 2>/dev/null; then
    kill "-$signal" "$child_pid" 2>/dev/null || kill -"$signal" "$child_pid" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
  fi
}
shutdown_after_interrupt() {
  if [[ -z "$child_pid" ]]; then
    return
  fi
  # An interactive Ctrl-C is delivered to the full foreground process group,
  # so give Uvicorn the signal it already received instead of immediately
  # sending a duplicate interrupt through the launcher. A parent-only INT is
  # still bounded: after one second the launcher terminates its child.
  for _ in {1..10}; do
    if ! kill -0 "$child_pid" 2>/dev/null; then
      wait "$child_pid" 2>/dev/null || true
      return
    fi
    sleep 0.1
  done
  shutdown TERM
}
trap 'shutdown TERM' EXIT
trap 'shutdown_after_interrupt; exit 130' INT
trap 'shutdown TERM; exit 143' TERM

