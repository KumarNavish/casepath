    "documents": [
      {
        "id": "tenancy_terms_evidence",
        "checked": "true",
        "check": "op_a043e4141338b87224a4e40580b56799",
        "citation": "{\"artifact_id\":\"src_5d8ceb740a1e48c3148d148dffd96bdf\",\"end_char\":434,\"offset_unit\":\"unicode_code_point\",\"quote\":\"I, Nina Steiner, am the tenant under an indefinite ordinary residential lease for Synthetic Rosenweg 48, 8008 Zurich, canton Zurich. The landlord is Synthetische Wohnraum AG. Current monthly net rent is CHF1650; the landlord maintains the fixed central heating and circulation pump. The lease requires usable heated living rooms in winter.\",\"sha256\":\"3589eeb27828e5e11a952f81c67f869024e31e66ddf7b3e907214711930ffca0\",\"start_char\":95,\"text_sha256\":\"3589eeb27828e5e11a952f81c67f869024e31e66ddf7b3e907214711930ffca0\"}"
      },
      {
        "id": "landlord_knowledge_evidence",
        "checked": "true",
        "check": "op_2764e0fa09245fd4e94bfbd5d4922793",
        "citation": "{\"artifact_id\":\"src_74fde318eb71f96b9cef43a0538a581b\",\"end_char\":494,\"offset_unit\":\"unicode_code_point\",\"quote\":\"Our call log records Nina Steiner's three heating-failure reports on 2025-01-21, 2025-01-24, 2025-01-28. Each report identified the same rented flat and recurrent stoppage of the fixed heating. We received the first report on2025-01-21; this is the landlord's first documented knowledge of the defect.\",\"sha256\":\"691c9cd457b5f4d11106706eea705cd9d0c1c5186eadaa3e1dcd3660b702c916\",\"start_char\":193,\"text_sha256\":\"691c9cd457b5f4d11106706eea705cd9d0c1c5186eadaa3e1dcd3660b702c916\"}"
      },
      {
        "id": "objective_defect_observation",
