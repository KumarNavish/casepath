    "documents": [
      {
        "id": "tenancy_terms_evidence",
        "checked": "true",
        "check": "op_239fff8e940e09cd50d910cbaff753b7",
        "citation": "{\"artifact_id\":\"src_106168f9c33152b3d88f02469ad57782\",\"end_char\":434,\"offset_unit\":\"unicode_code_point\",\"quote\":\"I, Riley Foster, am the tenant under an indefinite ordinary residential lease for Synthetic Rosenweg 33, 8008 Zurich, canton Zurich. The landlord is Synthetische Wohnraum AG. Current monthly net rent is CHF1800; the landlord maintains the fixed central heating and circulation pump. The lease requires usable heated living rooms in winter.\",\"sha256\":\"b43fd882524544b4b860f54eedfe4f1b76fa12b0c7af6502c02b089030d699b9\",\"start_char\":95,\"text_sha256\":\"b43fd882524544b4b860f54eedfe4f1b76fa12b0c7af6502c02b089030d699b9\"}"
      },
      {
        "id": "landlord_knowledge_evidence",
        "checked": "true",
        "check": "op_96acd4eb60e2706174feaa5552f164f8",
        "citation": "{\"artifact_id\":\"src_c57d943a64c85cf37369ccbf747b6e3f\",\"end_char\":494,\"offset_unit\":\"unicode_code_point\",\"quote\":\"Our call log records Riley Foster's three heating-failure reports on 2025-02-01, 2025-02-08, 2025-02-17. Each report identified the same rented flat and recurrent stoppage of the fixed heating. We received the first report on2025-02-01; this is the landlord's first documented knowledge of the defect.\",\"sha256\":\"1b19130a0ec03df636b69a63aedd84c36c00b5601b65bd347532b487ec824569\",\"start_char\":193,\"text_sha256\":\"1b19130a0ec03df636b69a63aedd84c36c00b5601b65bd347532b487ec824569\"}"
      },
      {
        "id": "objective_defect_observation",
        "checked": "true",
        "check": "op_1b4045f495bd7c43aee1c82408feaba3",
        "citation": "{\"artifact_id\":\"src_000ccf161644df9e82d29a8595b7b727\",\"end_char\":764,\"offset_unit\":\"unicode_code_point\",\"quote\":\"On 2025-02-21 at07:30, a calibrated digital instrument (calibration check2024-12-15, uncertainty±0.2C) measured the living room at15.8C after overnight normal operation. Main living rooms stayed15.5–16.3C in the seven-day logger record. Resets restore heat briefly; the pump cuts out repeatedly. The fixed circulation pump has an internal bearing/control failure; it is part of landlord-maintained equipment, outside ordinary small tenant maintenance. Normal ventilation and unobstructed radiators were observed; no tenant alteration or misuse explains the failure.\",\"sha256\":\"a5e40553523e2dcee2df0f7f1acf40f8743fd93ff0260cf81ee3004ff78e8e1c\",\"start_char\":199,\"text_sha256\":\"a5e40553523e2dcee2df0f7f1acf40f8743fd93ff0260cf81ee3004ff78e8e1c\"}"
      }
