': 'Dated photographs', 'required_at_node_ids': ['dh_evidence'], 'requirement_class': 'mandatory'}, {'condition': None, 'document_type': 'landlord_response_history', 'label': 'Landlord response history', 'required_at_node_ids': ['dh_response'], 'requirement_class': 'mandatory'}, {'condition': "scenario flag 'mold' is active", 'document_type': 'humidity_temperature_log', 'label': 'Humidity and temperature log', 'required_at_node_ids': ['dh_evidence'], 'requirement_class': 'conditional'}, {'condition': "scenario flag 'heating' is active", 'document_type': 'heating_service_report', 'label': 'Heating service report', 'required_at_node_ids': ['dh_evidence'], 'requirement_class': 'conditional'}, {'condition': "scenario flag 'health_effects' is active", 'document_type': 'medical_confirmation', 'label': 'Medical confirmation', 'required_at_node_ids': ['dh_safety'], 'requirement_class': 'conditional'}, {'condition': "scenario flag 'specialist_needed' is active", 'document_type': 'technical_inspection', 'label': 'Technical inspection', 'required_at_node_ids': ['dh_specialist'], 'requirement_class': 'conditional'}, {'condition': "scenario flag 'deposit_considered' is active", 'document_type': 'written_repair_deadline', 'label': 'Written repair deadline', 'required_at_node_ids': ['dh_deposit'], 'requirement_class': 'conditional'}, {'condition': None, 'document_type': 'caretaker_correspondence', 'label': 'Caretaker correspondence', 'required_at_node_ids': ['dh_cause'], 'requirement_class': 'optional'}], 'nodes': [{'label': 'Capture defect and affected rooms', 'node_id': 'dh_intake', 'responsibility': 'claim_handler', 'terminal': False}, {'label': 'Escalate immediate health or safety risk', 'node_id': 'dh_safety', 'responsibility': 'external_specialist', 'terminal': False}, {'label': 'Build the dated defect timeline', 'node_id': 'dh_scope', 'responsibility': 'claim_handler', 'terminal': False}, {'label': 'Establish landlord notice', 'node_id': 'dh_notice', 'responsibility': 'clai