+            if stop == 'deadline':
+                assert cancellation.wait(1)
+            else:
+                # A nonreading client must leave the producer at the existing queue bound.
+                for index in range(100):
+                    send({'type': 'operation', 'id': index, 'text': 'x' * 400000})
