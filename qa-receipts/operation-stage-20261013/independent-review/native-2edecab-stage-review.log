    {
      "claim_id": "clm_314f2d309fea25e6",
      "operation_id": "op_12368bafbf1e6c58a43a2a13af446bcb",
      "id": "fact:objective_defect_observation",
      "full": "measured the living room at15.8C after overnight normal operation.",
      "compact": "15.8C",
      "original_pin_returned": false,
      "source": {
        "artifact_id": "src_000ccf161644df9e82d29a8595b7b727",
        "end_char": 764,
        "offset_unit": "unicode_code_point",
        "quote": "On 2025-02-21 at07:30, a calibrated digital instrument (calibration check2024-12-15, uncertainty±0.2C) measured the living room at15.8C after overnight normal operation. Main living rooms stayed15.5–16.3C in the seven-day logger record. Resets restore heat briefly; the pump cuts out repeatedly. The fixed circulation pump has an internal bearing/control failure; it is part of landlord-maintained equipment, outside ordinary small tenant maintenance. Normal ventilation and unobstructed radiators were observed; no tenant alteration or misuse explains the failure.",
        "sha256": "a5e40553523e2dcee2df0f7f1acf40f8743fd93ff0260cf81ee3004ff78e8e1c",
        "start_char": 199,
        "text_sha256": "a5e40553523e2dcee2df0f7f1acf40f8743fd93ff0260cf81ee3004ff78e8e1c"
      }
    },
    {
      "claim_id": "clm_314f2d309fea25e6",
      "operation_id": "op_31bcd3404de1cb6592883fb7509d9cfc",
      "id": "fact:landlord_knowledge_evidence",
      "full": "call log records Riley Foster's three heating-failure reports on 2025-02-01, 2025-02-08, 2025-02-17.",
      "compact": "three heating-failure reports",
      "original_pin_returned": false,
      "source": {
        "artifact_id": "src_c57d943a64c85cf37369ccbf747b6e3f",
        "end_char": 494,
        "offset_unit": "unicode_code_point",
        "quote": "Our call log records Riley Foster's three heating-failure reports on 2025-02-01, 2025-02-08, 2025-02-17. Each report identified the same rented flat and recurrent stoppage of the fixed heating. We received the first report on2025-02-01; this is the landlord's first documented knowledge of the defect.",
        "sha256": "1b19130a0ec03df636b69a63aedd84c36c00b5601b65bd347532b487ec824569",
        "start_char": 193,
        "text_sha256": "1b19130a0ec03df636b69a63aedd84c36c00b5601b65bd347532b487ec824569"
      }
    },
