    {
      "claim_id": "clm_314f2d309fea25e6",
      "operation_id": "op_1715b98c5f009b94cad03526c1c661be",
      "id": "fact:tenancy_terms_evidence",
      "full": "monthly net rent is CHF1800; the landlord maintains the fixed central heating and circulation pump.",
      "compact": "CHF1800",
      "original_pin_returned": false,
      "source": {
        "artifact_id": "src_106168f9c33152b3d88f02469ad57782",
        "end_char": 434,
        "offset_unit": "unicode_code_point",
        "quote": "I, Riley Foster, am the tenant under an indefinite ordinary residential lease for Synthetic Rosenweg 33, 8008 Zurich, canton Zurich. The landlord is Synthetische Wohnraum AG. Current monthly net rent is CHF1800; the landlord maintains the fixed central heating and circulation pump. The lease requires usable heated living rooms in winter.",
        "sha256": "b43fd882524544b4b860f54eedfe4f1b76fa12b0c7af6502c02b089030d699b9",
        "start_char": 95,
