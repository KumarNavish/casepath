    rounded(d,(629,362,889,414),12,fill=AMBER_SOFT,outline=AMBER)
    text(d,(647,374),'Building-envelope assessment',F['bold_sm'])
    text(d,(647,394),'Conditional—not requested yet',F['xs'],fill=AMBER)
    text(d,(762,447),'One reviewed claim → better next claim',F['bold_sm'],fill=GREEN,anchor='mm')


